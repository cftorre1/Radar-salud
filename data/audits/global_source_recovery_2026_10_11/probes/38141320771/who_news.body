    var backToActivityLabel = "< Back to the activity page";
    var hubPageLabel = breadcrumb_overview_label[cultureIndex];

    if (referrerUrl) {

        var breadcrumbItems = $(".sf-breadscrumb.breadcrumb li");
        //remove breadcrumb items from start to end (leave only the first one)
        var start = 1;
        var end = breadcrumbItems.length;

        var isHealthTopicUrl = referrerUrl.indexOf("/health-topics/") != -1;
        var isTeamsUrl = referrerUrl.indexOf("/teams/") != -1;
        var isActivityUrl = referrerUrl.indexOf("/activities/") != -1;
        var updateBreadcrumb = isHealthTopicUrl || isTeamsUrl || isActivityUrl;

        if (updateBreadcrumb) {
            breadcrumbItems.slice(1, end).remove();
            $(".sf-breadscrumb.breadcrumb li span").remove();

            if (isHealthTopicUrl) {
                $(".sf-breadscrumb.breadcrumb li a").text(backToHealthTopicLabel);
            }
            if (isTeamsUrl) {
                $(".sf-breadscrumb.breadcrumb li a").text(backToTeamsLabel);
            }
            if (isActivityUrl) {
                $(".sf-breadscrumb.breadcrumb li a").text(backToActivityLabel);
            }

            $(".sf-breadscrumb.breadcrumb li a").attr("href", document.referrer);
        }
        //else {
           // $(".sf-breadscrumb.breadcrumb li.active").text(hubPageLabel);
        //}
    }
    //else {
        //$(".sf-breadscrumb.breadcrumb li.active").text(hubPageLabel);
    //}
});
