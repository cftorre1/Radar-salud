    h1 {
      font-size: 40px;
    }

    header {
      height: 80px;
      width: 100%;
      border-bottom: 1px solid #CCC;
    }

    header .logo {
      margin: 20px 0 0 25px;
      text-align: leftt;
    }

    .background-img {
      background: url('/themes/paho/images/404/404-error-es.jpg') no-repeat;
      background-repeat: no-repeat;
      background-size: cover;
      /* Adjust image size as needed */
      background-position: left;
    }


    /*Start*/
    .image-box {
      /* Here's the trick */
      box-shadow: inset 0 0 0 100vw rgba(0, 0, 0, 0);

      /* Basic background styles */
      background: var(--image-url) center center;
      background-size: cover;

      /* Here's the same styles we applied to our content-div earlier */
      min-height: 109vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-repeat: no-repeat;
    }

    /*End*/


    a {
      color: #00205C;
      font-weight: bold;
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }

    .text-center {
      text-align: center !important;
      padding-left: 20%;
      margin-top: 22%;
    }

    .links {
      margin-top: 20px;
    }

    .footer {
      background-color: #00205C;
      color: #ffffff;
      padding: 20px 0 40px 0;
    }

    .footer a {
      color: #ffffff;
      text-decoration: none;
      font-family: "Noto Sans", Arial, Helvetica, sans-serif;
      font-weight: normal;
    }

    .footer h2 {
      font-size: 30px;
    }

    .footer .text-align-center {
      text-align: center;
    }

    .footer ul {
      list-style: none;
      padding-left: 0 !important;
    }

    .footer ul>li>a {
      padding: 3px 0px;
      line-height: 2;
    }

    .s-media img {
      width: 24px;
      height: 24px;
    }

    .social-media-links li {
      display: inline-block;
    }

    /*DESKTOP*/
    @media screen and (min-width:1200px) and (max-width: 9999px) {
      .mycontent {
        max-width: 933px;
        margin: 449px 0 0px 365px;
        text-align: center;
        /*border: 1px solid orange;*/
      }
    }

    /*DESKTOP BROWSER ON SMALL MONITOR*/
    @media screen and (min-width:768px) and (max-width: 1199px) {
      .mycontent {
        max-width: 933px;
        margin: 550px 0 0px 200px;
        text-align: center;
        /*border: 2px solid blue;*/
      }
    }

    /*MOBILE LANDSCAPE*/
    @media screen and (min-width: 481px) and (max-width: 767px) {
      .mycontent {
        /*border: 2px solid green;*/
        background-color: #ffffff;
      }

      .image-box {
        background: var(--image-url) top center !important;
        background-size: contain !important;
        background-repeat: no-repeat !important;
      }

      .mycontent {
        max-width: 933px;
        margin: 45px 0 0 0;
        text-align: center;

      }

      .logo img {
        width: 384px !important;
      }
    }

    /*ALL MOBILE PHONES PORTRAIT*/
    @media screen and (min-width: 1px) and (max-width: 480px) {
      header {
        height: 50px;
      }

      .image-box {
        background: var(--image-url) top center !important;
        background-size: contain !important;
        background-repeat: no-repeat !important;
        display: table-cell;
      }

      .mycontent {
        max-width: 92%;
        margin: 275px 0 0 0;
        text-align: center;
        /*border: 2px solid red;*/
        margin-left: auto;
        margin-right: auto;
      }

      header .logo {
        margin: 10px 0 0 15px;
      }

      .logo img {
        width: 320px !important;
      }
    }
