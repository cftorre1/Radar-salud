	<div class="wpb_raw_code wpb_raw_js" >
		<div class="wpb_wrapper">
			<script type="text/rocketlazyloadscript" data-rocket-type="text/javascript">
(function () {
  function getWspBtn() {
    return document.querySelector('.boton-wsp-flotante');
  }
  function isMobile() {
    return window.innerWidth <= 577;
  }
  function mostrarModal() {
    var modalBg = document.getElementById('popup-nuevo');
    if (!modalBg) return;
    modalBg.style.display = 'flex';
    if (isMobile()) {
      var botonWsp = getWspBtn();
      if (botonWsp) botonWsp.style.display = 'none';
    }
  }
  function cerrarModal() {
    var modalBg = document.getElementById('popup-nuevo');
    if (modalBg) modalBg.style.display = 'none';
    if (isMobile()) {
      var botonWsp = getWspBtn();
      if (botonWsp) botonWsp.style.display = 'block';
    }
  }
  function init() {
    var dektop = document.getElementById("modal-temporal");
    var mobile = document.getElementById("popup-mobile");
    
    // ----- Desktop -----
    if (dektop) {
      var imageWrapperD = dektop.querySelector('.vc_single_image-wrapper');
      if (imageWrapperD && !document.getElementById('btn-cerrar-popup')) {
        var btn = document.createElement('button');
        btn.id = 'btn-cerrar-popup';
        btn.textContent = 'X';
        imageWrapperD.appendChild(btn);
      }
    }
    
    // ----- Mobile -----
    if (mobile) {
      var imageWrapperM = mobile.querySelector('.vc_single_image-wrapper');
      if (imageWrapperM && !document.getElementById('btn-cerrar-popup-m')) {
        var btnM = document.createElement('button');
        btnM.id = 'btn-cerrar-popup-m';
        btnM.textContent = 'X';
        imageWrapperM.appendChild(btnM);
      }
    }

    // MANEJO DE CLICS (Cerrar popup y controlar enlaces)
    document.addEventListener('click', function (e) {
      var popup = document.getElementById('popup-nuevo');
      if (!popup) return;

      // 1. SI SE CLICKEA LA "X" (Cerrar de golpe y frenar la propagación al enlace)
      if (e.target.id === 'btn-cerrar-popup' || e.target.id === 'btn-cerrar-popup-m') {
        e.preventDefault();
        e.stopPropagation(); // <-- Vital: Evita que el clic "atraviese" hacia la imagen/enlace
        cerrarModal();
        return;
      }

      // 2. SI SE CLICKEA FUERA DEL POPUP (En el fondo oscuro)
      if (e.target.id === 'popup-nuevo') {
        cerrarModal();
        return;
      }

      // 3. LOGICA DE LA IMAGEN (Solo si el clic es dentro del contenido del popup)
      if (popup.contains(e.target)) {
        var link = e.target.closest('a');
        if (link) {
          var url = link.getAttribute('href');
          
          // Si no tiene enlace configurado en WP Bakery (vacío o "#"), bloqueamos
          if (!url || url === '#' || url.trim() === '') {
            e.preventDefault();
            e.stopPropagation();
          }
          // Si tiene enlace real, no hace nada aquí y el navegador redirige normalmente
        }
      }
    }, true); // Usamos 'true' (capture) para interceptar el clic antes de que llegue a los elementos hijo

    // COMODIDAD: CERRAR CON LA TECLA "ESC"
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.keyCode === 27) {
        var popup = document.getElementById('popup-nuevo');
        // Solo cerramos si el popup está actualmente visible
        if (popup && popup.style.display === 'flex') {
          cerrarModal();
        }
      }
    });

    setTimeout(mostrarModal, 2000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
		</div>
	</div>
