/* Carrusel custom */
.carousel {
  width: 100%;
  overflow: hidden;
  position: relative;
}

.carousel-track {
  display: flex;
  transition: transform 0.5s ease;
}

.carousel-slide {
  min-width: 100%;
  box-sizing: border-box;
  position: relative;
}

/* Imágenes ocupan todo el ancho */
.carousel-slide img {
  width: 100%;
  height: auto;
  display: none;
}

/* Mostrar la imagen en desktop */
.carousel-slide img.desktop {
  display: none;
}

/* Mostrar la imagen en mobile */
.carousel-slide img.mobile {
  display: block;
}

/* Mostrar la imagen correspondiente según el ancho de pantalla */
@media (min-width: 768px) {
  .carousel-slide img.desktop {
    display: block;
  }
  .carousel-slide img.mobile {
    display: none;
  }
}

/* Paginación del carrusel */
.carousel-pagination {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  justify-content: center;
  width: 100%;
}

.carousel-page {
  color: #002a6c;
  cursor: pointer;
  padding: 5px 10px;
  font-size: 12px;
  transition: 0.3s;
  width: 100%;
  border-top: 3px solid #002a6c7d;
  text-align: center;
}
.carousel-page:hover {
  background-color: #002a6c2b;
}
.carousel-page.active {
  border-top-color: #002a6c;
  background-color: #002a6c2b;
  font-weight: 700;
}
@media (min-width: 480px){
    .carousel-page {
      padding: 10px;
      font-size: 14px;
    }
}
@media (min-width: 768px){
    .carousel-page {
      padding: 5px;
    }
}
@media (min-width: 1010px){
    .carousel-page {
      padding: 8px;
    }
}
@media (min-width: 1250px){
    .carousel-page {
      padding: 12px;
    }
}
/**/
.announcement-new-container, .announcement-new{
    display: flex;
