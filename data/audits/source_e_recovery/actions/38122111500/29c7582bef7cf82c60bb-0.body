}
.announcement-new-container{
    gap: 30px;
}
.announcement-new{
    justify-content: space-between;
    align-items: start;
    background-color: transparent;
    background-position: bottom;
    background-size: cover;
    padding: 20px;
}
.announcement-new h2{
    font-size: 22px;
    margin-bottom: 30px;
}
.announcement-new p{
    font-size: 16px;
    padding: 0;
    padding-bottom: 30px;
}
.announcement-new a{
    display: block;
    margin-top: auto;
}
.announcement-new h2, .announcement-new p, a.more.mc-button.light{
    color: #fff;
}
@media (min-width: 768px) {
    .announcement-new-container{
        flex-direction: row;
        gap: 10px;
    }
    .announcement-new{
        width: 50%;
    }
}
@media (min-width: 1010px) {
    .announcement-new-container{
        gap: 30px;
    }
    .announcement-new h2{
        font-size: 24px;
    }
}
