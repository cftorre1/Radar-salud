<script>
function moveFilter() {
    const filterElement = document.getElementById('div-2');
    const sectiontitleElement = document.getElementById('section-title');
    const sectionfilterElement = document.getElementById('section-filtros');

    if (window.innerWidth <= 800) {
        sectiontitleElement.appendChild(filterElement);
    } else {
        if (sectionfilterElement.firstChild) {
            sectionfilterElement.insertBefore(filterElement, sectionfilterElement.firstChild);
        } else {
            sectionfilterElement.appendChild(filterElement);
        }
    }
}

const selectElement = document.getElementById('product-select');
const components = document.querySelectorAll('.wb-products');
let noResultsMessage = null; 
const newsContainer = document.querySelector('.news-container'); 

function updateActiveComponent(selectedValue) {
    components.forEach(component => {
        component.classList.remove('active');
        component.classList.remove('visible');
    });

    if (noResultsMessage) {
        noResultsMessage.remove();
        noResultsMessage = null;
    }

    newsContainer.style.justifyContent = ''; 

    if (!selectedValue) {
        const defaultComponent = document.getElementById('component-0');
        defaultComponent.classList.add('active');
        setTimeout(() => defaultComponent.classList.add('visible'), 10);
    } else {
        const activeComponent = document.getElementById(`component-${selectedValue}`);
        const selectedCategoryText = selectElement.options[selectElement.selectedIndex].text;

        if (activeComponent && activeComponent.querySelector('.card-noticia')) {
            activeComponent.classList.add('active');
            setTimeout(() => activeComponent.classList.add('visible'), 10);
        } else if (window.innerWidth > 800) {
            noResultsMessage = document.createElement('div');
            noResultsMessage.className = 'card-noticia';
            noResultsMessage.innerHTML = `
                <div class="card-content" style="border: none; display: flex; flex-direction: column; justify-content: flex-start;">
                    <div class="etiquetas">
                        <div class="tags"></div>
                        <div class="divider-uikit-mutual" style="display: none;"></div>
                        <div class="fecha"></div>
                    </div>
                    <p class="title-card">Sin resultados</p>
                    <p class="descrption-card">
                        No hemos encontrado resultados para: <strong>${selectedCategoryText}</strong>. Prueba con otra categoría.
                    </p>
                </div>
            `;
            noResultsMessage.style.width = '602px';
            noResultsMessage.style.margin = '0 auto';
            noResultsMessage.style.boxSizing = 'border-box';
            newsContainer.style.justifyContent = 'flex-start';
            newsContainer.insertBefore(noResultsMessage, newsContainer.firstChild);
        }
    }
}

// Función para obtener el parámetro 'category' de la URL
function getCategoryFromURL() {
    const urlParams = new URLSearchParams(window.location.search);
    return urlParams.get('category') || '';
}

// Función para actualizar la URL con el valor seleccionado
function updateURL(selectedValue) {
    const url = new URL(window.location);
    if (selectedValue) {
        url.searchParams.set('category', selectedValue);
    } else {
        url.searchParams.delete('category');
    }
    window.history.pushState({}, document.title, url);
}

selectElement.addEventListener('change', (event) => {
    const selectedValue = event.target.value;
    localStorage.setItem('selectedCategory', selectedValue);
    updateURL(selectedValue);
    updateActiveComponent(selectedValue);
});

document.addEventListener('DOMContentLoaded', function () {
    moveFilter(); 

    let savedCategory = getCategoryFromURL();
    if (!savedCategory) {
        savedCategory = localStorage.getItem('selectedCategory') || '';
    }

    // Solo ejecutar si no se manejó en el script del head
    if (!document.querySelector('.wb-products.active')) {
        if (savedCategory && savedCategory !== "") {
            selectElement.value = savedCategory;
            updateActiveComponent(savedCategory);
        } else {
            selectElement.value = ""; 
            updateActiveComponent('');
        }
    }

    const cards = document.querySelectorAll(".card-noticia");
    cards.forEach(card => {
        const etiquetasDiv = card.querySelector(".etiquetas");
        const originalTag = etiquetasDiv.querySelector(".tag");
        const originalTagFillPrimary = originalTag.querySelector(".tag-fill-primary");
        const spanTexto = originalTagFillPrimary.querySelector(".small-text").textContent;

        const etiquetasArray = spanTexto.split(",");
        originalTag.className = "tags";
        originalTag.removeChild(originalTagFillPrimary);

        etiquetasArray.forEach(etiqueta => {
            const newTag = document.createElement("div");
            newTag.className = "tag";
            newTag.innerHTML = `
                <div class="tag-fill-primary">
                    <span class="material-symbols-rounded size-12"></span>
                    <span class="small-text">${etiqueta.trim()}</span>
                    <span class="material-symbols-rounded size-12-close"></span>
                </div>
            `;
            originalTag.appendChild(newTag);
        });
    });
});

window.onresize = moveFilter;
</script>
        
        
    

    
        





        







    
<div class="wpthemeClear"></div>
	</div>
</section></div>
		</td>
	</tr>
	 
</table>
