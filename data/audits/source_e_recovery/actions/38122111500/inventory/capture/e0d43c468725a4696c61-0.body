<div class="paginadocss"><span>Primera</span><span>chevron_backward</span><span>1</span><span>chevron_forward</span><span>Última</span></div>
<script>
for (let i = 0; i <= 22; i++) {
    let component = document.querySelector(`#component-${i} .paginadocss`);
    if (!component) continue; // Si el componente no existe, sigue con el siguiente
    
    let spans = component.querySelectorAll("span");
    if (spans.length < 2) continue; // Evita errores si hay menos de dos spans

    spans[0].classList.add('no-display');
    spans[spans.length - 1].classList.add('no-display');

    if (spans.length > 3) { // Solo aplica las clases si hay suficientes elementos
        spans[1].classList.add('material-symbols-rounded', 'icon-backward', 'navigation-icon');
        spans[spans.length - 2].classList.add('material-symbols-rounded', 'icon-forward', 'navigation-icon');
    }
}

</script>

