<div id="nuevo-paginador">
  <style>
    #nuevo-paginador {
      width: 100%;
      display: flex;
      justify-content: center;
    }

    #nuevo-paginador .paginacion-noticias {
      display: flex;
      width: 100%;
      height: 78px;
      justify-content: center;
      gap: 10px;
      padding: 16px;
      margin: 16px auto 0 auto;
      background-color: var(--variable-collection-color-grey-light-06);
      border-radius: 8px;
      border: 1px solid;
      border-color: var(--variable-collection-card-border-card-elevation);
      box-shadow: var(--variable-collection-card-shadow);
      align-items: center;
      position: relative;
      overflow: hidden;
      font-family: var(--span-regular-font-family);
      font-weight: var(--span-regular-font-weight);
      color: var(--variable-collection-button-tertiary-text-outline);
      font-size: var(--span-regular-font-size);
      letter-spacing: var(--span-regular-letter-spacing);
      line-height: var(--span-regular-line-height);
      font-style: var(--span-regular-font-style);
    }

    .paginacion-noticias .paginadocss {
      display: inline-flex;
      gap: 24px;
      flex: 0 0 auto;
      align-items: center;
      position: relative;
    }

    .paginacion-noticias .pages {
      display: inline-flex;
      align-items: center;
      gap: 12px;
    }

    .paginacion-noticias .page-btn,
    .paginacion-noticias .nav-btn {
      display: flex;
      width: 36px;
      height: 38px;
      align-items: center;
      justify-content: center;
      position: relative;
      cursor: pointer;
      background-color: white;
      border-radius: var(--variable-collection-24);
      color: var(--variable-collection-pagination-number-active);
      border: none;
      padding: 0;
      font: inherit;
      margin: 0 6px;
    }

    .paginacion-noticias .page-btn.active {
      background-color: var(--variable-collection-pagination-bg-number);
    }

    .paginacion-noticias .page-btn:not(.active):hover,
    .paginacion-noticias .nav-btn:hover {
      border-radius: var(--variable-collection-8);
      background-color: var(--variable-collection-color-brand-blue-07);
      box-shadow: 0px 0px 35px #e7ebf680;
      color: var(--variable-collection-pagination-number-active);
      width: 36px;
      height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      flex: 0 0 auto;
    }

    .paginacion-noticias .nav-btn .material-symbols-rounded {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      background-color: transparent;
      border-radius: 0;
    }

    .paginacion-noticias .nav-btn.disabled {
      opacity: 0.4;
      pointer-events: none;
    }

    .no-display {
      display: none;
    }

    .hidden-duplicate-card {
      display: none !important;
    }
  </style>

  <div class="paginacion-noticias">
    <div class="paginadocss">
      <button type="button" class="nav-btn prev" aria-label="Primera página">
        <span class="material-symbols-rounded">chevron_backward</span>
      </button>

      <div class="pages"></div>

      <button type="button" class="nav-btn next" aria-label="Última página">
        <span class="material-symbols-rounded">chevron_forward</span>
      </button>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const pageSize = 5;
      let paginador = document.getElementById('nuevo-paginador');
      if (!paginador) return;

      const cardsAncestor = paginador.closest('.cards-noticias');
      if (cardsAncestor) {
        const initialNewsContainer = document.querySelector('.news-container');
        if (initialNewsContainer) {
          initialNewsContainer.appendChild(paginador);
        }
      }

      document.querySelectorAll('.paginacion-noticias').forEach(function (p) {
        if (!p.closest('#nuevo-paginador')) {
          p.style.display = 'none';
        }
      });

      const prevBtn = paginador.querySelector('.nav-btn.prev');
      const nextBtn = paginador.querySelector('.nav-btn.next');
      const pagesContainer = paginador.querySelector('.pages');
      const selectElement = document.getElementById('product-select');
      const newsContainer = document.querySelector('.news-container');

      if (!prevBtn || !nextBtn || !pagesContainer || !newsContainer) return;

      let allComponents = [];
      let currentPage = 1;
      let pageButtons = [];
      let visiblePages = [];
      let dynamicResultsComponent = null;

      function normalizeText(value) {
        return (value || '').trim().toLowerCase();
      }

      function getCardKey(card) {
        const link = card.querySelector('a.href-button');
        if (link) {
          return link.getAttribute('href') || link.textContent.trim();
        }

        const title = card.querySelector('.title-card');
        return title ? title.textContent.trim() : card.textContent.trim();
      }

      function getCardTags(card) {
        return Array.from(card.querySelectorAll('.tags .small-text')).map(function (tag) {
          return normalizeText(tag.textContent);
        });
      }

      function parseCardDate(value) {
        if (!value) return 0;

        const rawValue = value.trim();
        if (!rawValue) return 0;

        const isoMatch = rawValue.match(/(\d{4})[\/\-](\d{1,2})[\/\-](\d{1,2})/);
        if (isoMatch) {
          return new Date(
            parseInt(isoMatch[1], 10),
            parseInt(isoMatch[2], 10) - 1,
            parseInt(isoMatch[3], 10)
          ).getTime();
        }

        const normalized = rawValue
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/,/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();

        const months = {
          enero: 0,
          febrero: 1,
          marzo: 2,
          abril: 3,
          mayo: 4,
          junio: 5,
          julio: 6,
          agosto: 7,
          septiembre: 8,
          setiembre: 8,
          octubre: 9,
          noviembre: 10,
          diciembre: 11
        };

        let match = normalized.match(/(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})/);
        if (match) {
          const day = parseInt(match[1], 10);
          const month = parseInt(match[2], 10) - 1;
          let year = parseInt(match[3], 10);

          if (year < 100) {
            year += 2000;
          }

          return new Date(year, month, day).getTime();
        }

        match = normalized.match(/(\d{1,2})\s+de\s+([a-z]+)\s+de\s+(\d{4})/);
        if (match && Object.prototype.hasOwnProperty.call(months, match[2])) {
          return new Date(parseInt(match[3], 10), months[match[2]], parseInt(match[1], 10)).getTime();
        }

        match = normalized.match(/(\d{1,2})\s+([a-z]+)\s+(\d{4})/);
        if (match && Object.prototype.hasOwnProperty.call(months, match[2])) {
          return new Date(parseInt(match[3], 10), months[match[2]], parseInt(match[1], 10)).getTime();
        }

        const nativeParsed = Date.parse(rawValue);
        if (!isNaN(nativeParsed)) {
          return nativeParsed;
        }

        return 0;
      }

      function extractCardDate(card) {
        const candidates = [
          card.querySelector('time[datetime]') ? card.querySelector('time[datetime]').getAttribute('datetime') : '',
          card.querySelector('time') ? card.querySelector('time').textContent : '',
          card.querySelector('[data-date]') ? card.querySelector('[data-date]').getAttribute('data-date') : '',
          card.querySelector('.date') ? card.querySelector('.date').textContent : '',
          card.querySelector('.fecha') ? card.querySelector('.fecha').textContent : '',
          card.querySelector('.news-date') ? card.querySelector('.news-date').textContent : '',
          card.querySelector('.card-date') ? card.querySelector('.card-date').textContent : '',
          card.querySelector('.publish-date') ? card.querySelector('.publish-date').textContent : ''
        ];

        for (let i = 0; i < candidates.length; i++) {
          const timestamp = parseCardDate(candidates[i]);
          if (timestamp) {
            return timestamp;
          }
        }

        return 0;
      }

      function refreshComponentsCollection() {
        allComponents = Array.from(newsContainer.querySelectorAll('[id^="component-"]')).filter(function (comp) {
          return comp.id !== 'component-filtered-dynamic' && comp.querySelector('.card-noticia');
        });
      }

      function ensureDynamicResultsComponent() {
        if (dynamicResultsComponent) {
          return dynamicResultsComponent;
        }

        dynamicResultsComponent = document.createElement('div');
        dynamicResultsComponent.id = 'component-filtered-dynamic';
        dynamicResultsComponent.className = 'cards-noticias wb-products wb-text';

        newsContainer.insertBefore(dynamicResultsComponent, paginador);
        return dynamicResultsComponent;
      }

      function hideSourceComponents() {
        allComponents.forEach(function (comp) {
          comp.classList.remove('active', 'visible');
          comp.style.display = 'none';
        });
      }

      function collectUniqueCards(categoryText) {
        const selectedCategory = normalizeText(categoryText);
        const seenKeys = new Set();
        const uniqueCards = [];

        allComponents.forEach(function (component) {
          const cards = component.querySelectorAll('.card-noticia');

          cards.forEach(function (card) {
            const key = normalizeText(getCardKey(card));
            if (!key || seenKeys.has(key)) {
              return;
            }

            if (selectedCategory) {
              const tags = getCardTags(card);
              if (!tags.includes(selectedCategory)) {
                return;
              }
            }

            seenKeys.add(key);
            uniqueCards.push({
              html: card.outerHTML,
              timestamp: extractCardDate(card)
            });
          });
        });

        uniqueCards.sort(function (a, b) {
          return b.timestamp - a.timestamp;
        });

        return uniqueCards.map(function (item) {
          return item.html;
        });
      }

      function chunkArray(items, size) {
        const result = [];
        for (let i = 0; i < items.length; i += size) {
          result.push(items.slice(i, i + size));
        }
        return result;
      }

      function getSelectedCategoryText() {
        if (!selectElement) return '';

        const value = selectElement.value;
        if (!value || value === '0') return '';

        const option = selectElement.options[selectElement.selectedIndex];
        return option ? option.text : '';
      }

      function rebuildPages() {
        const categoryText = getSelectedCategoryText();
        const uniqueCards = collectUniqueCards(categoryText);
        visiblePages = chunkArray(uniqueCards, pageSize);
      }

      function getTotalPages() {
        return visiblePages.length;
      }

      function renderPage(page) {
        const container = ensureDynamicResultsComponent();
        const cards = visiblePages[page - 1] || [];

        hideSourceComponents();

        container.innerHTML = cards.join('');
        container.style.display = '';
        container.classList.add('active');
        container.classList.remove('visible');

        setTimeout(function () {
          container.classList.add('visible');
        }, 10);
      }

      function setActiveButton(page) {
        pageButtons.forEach(function (btn, i) {
          btn.classList.toggle('active', i === page - 1);
        });
      }

      function updateArrows(page) {
        const totalPages = getTotalPages();
        prevBtn.classList.toggle('disabled', totalPages === 0 || page === 1);
        nextBtn.classList.toggle('disabled', totalPages === 0 || page === totalPages);
      }

      function updateVisibleNumbers(page) {
        const totalPages = getTotalPages();
        const maxVisible = 3;
        let start = page - 1;
        let end = page + 1;

        if (start < 1) {
          start = 1;
          end = Math.min(maxVisible, totalPages);
        }

        if (end > totalPages) {
          end = totalPages;
          start = Math.max(1, end - maxVisible + 1);
        }

        pageButtons.forEach(function (btn) {
          const p = parseInt(btn.dataset.page, 10);
          btn.style.display = p >= start && p <= end ? 'inline-flex' : 'none';
        });
      }

      function scrollToFirstCard() {
        const container = ensureDynamicResultsComponent();
        if (!container || !container.children.length) return;

        requestAnimationFrame(function () {
          const headerOffset = 120;
          const containerTop = container.getBoundingClientRect().top + window.pageYOffset;

          window.scrollTo({
            top: Math.max(0, containerTop - headerOffset),
            behavior: 'smooth'
          });
        });
      }

      function goToPage(page, shouldScroll) {
        const totalPages = getTotalPages();
        if (page < 1 || page > totalPages) return;

        currentPage = page;
        renderPage(page);
        setActiveButton(page);
        updateArrows(page);
        updateVisibleNumbers(page);

        if (shouldScroll) {
          scrollToFirstCard();
        }
      }

      function rebuildPaginator() {
        refreshComponentsCollection();
        if (allComponents.length === 0) return;

        rebuildPages();

        pagesContainer.innerHTML = '';
        pageButtons = [];
        currentPage = 1;

        const totalPages = getTotalPages();
        const dynamicComponent = ensureDynamicResultsComponent();

        if (totalPages === 0) {
          paginador.style.display = 'none';
          hideSourceComponents();
          dynamicComponent.innerHTML = '';
          dynamicComponent.classList.remove('active', 'visible');
          dynamicComponent.style.display = 'none';
          return;
        }

        paginador.style.display = 'flex';

        for (let page = 1; page <= totalPages; page++) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'page-btn';
          btn.textContent = page;
          btn.dataset.page = page;
          btn.setAttribute('aria-label', 'Ir a la página ' + page);
          pagesContainer.appendChild(btn);
          pageButtons.push(btn);
        }

        goToPage(1, false);
      }

      prevBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const totalPages = getTotalPages();
        if (totalPages === 0) return;
        goToPage(1, true);
      });

      nextBtn.addEventListener('click', function (e) {
        e.preventDefault();
        e.stopPropagation();

        const totalPages = getTotalPages();
        if (totalPages === 0) return;
        goToPage(totalPages, true);
      });

      pagesContainer.addEventListener('click', function (e) {
        const btn = e.target.closest('.page-btn');
        if (!btn) return;

        e.preventDefault();
        e.stopPropagation();

        const page = parseInt(btn.dataset.page, 10);
        if (!isNaN(page)) {
          goToPage(page, true);
        }
      });

      function rebuildWithDelay() {
        setTimeout(rebuildPaginator, 0);
        setTimeout(rebuildPaginator, 120);
      }

      if (selectElement) {
        selectElement.addEventListener('change', rebuildWithDelay);
      }

      window.addEventListener('load', rebuildWithDelay);

      const componentsObserver = new MutationObserver(function (mutations) {
        const hasNewComponents = mutations.some(function (mutation) {
          return Array.from(mutation.addedNodes).some(function (node) {
            return node.nodeType === 1 && /^component-\d+$/.test(node.id || '');
          });
        });

        if (hasNewComponents) {
          rebuildWithDelay();
        }
      });

      componentsObserver.observe(newsContainer, { childList: true });

      rebuildWithDelay();
    });
  </script>
</div>
          </div>
