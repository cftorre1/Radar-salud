<script>
    (function() {
        const urlParams = new URLSearchParams(window.location.search);
        const categoryFromURL = urlParams.get('category') || '';
        const savedCategory = categoryFromURL || localStorage.getItem('selectedCategory') || '';
        
        if (savedCategory) {
            document.addEventListener('DOMContentLoaded', function() {
                const selectElement = document.getElementById('product-select');
                const activeComponent = document.getElementById(`component-${savedCategory}`);
                if (selectElement && activeComponent) {
                    selectElement.value = savedCategory;
                    document.querySelectorAll('.wb-products').forEach(comp => comp.classList.remove('active'));
                    activeComponent.classList.add('active');
                    setTimeout(() => activeComponent.classList.add('visible'), 10);
                }
            });
        }
    })();
</script>

