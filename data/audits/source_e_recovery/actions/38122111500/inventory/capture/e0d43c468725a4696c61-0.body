<div class="card-noticia">
    <img class="image" src=/portal/wcm/connect/9f134f7c-1c23-4f06-b4de-4d3b4ebddecc/mutual_07.jpg?MOD=AJPERES&amp;CACHEID=ROOTWORKSPACE-9f134f7c-1c23-4f06-b4de-4d3b4ebddecc-pSYhIf7>
    <div class="card-content">
      <div class="etiquetas">
        <div class="tag">
