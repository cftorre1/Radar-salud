    }</style><style type="text/css" media="all">.custom-captcha {
  display: flex;
  flex-direction: column !important;
  width: 100% !important;
}


.custom-captcha label {
  display: none;
  margin-top: 12px;
}


.custom-captcha button {
  width: 35px;
  height: 35px;
  border: none;
  background: none;
  border: 1px solid #333;
  padding: 4px;
  border-radius: 4px;
}


.custom-captcha .form-group {
  width: 230px !important;
  width: 100%;
  margin-top: 12px;
  padding: 0;
  margin: 0 !important;
}


.custom-captcha .sf-icon-xxs {
  width: 18px;
  height: 25px;
  fill: #333;
}


.custom-captcha a {
  border: 1px solid #333;
    padding: 0;
    border-radius: 4px;
    width: 35px;
    height: 35px;
    display: flex;
    justify-content: center;
    position: static;
    padding: 0;
    align-items: center;
}


.custom-captcha a::before {
  content: "";
  display: block;
