<meta name="generator" content="Powered by WPBakery Page Builder - drag and drop page builder for WordPress."/>
<style data-type="vc_custom-css">html{
    scroll-behavior: smooth;
}
span.number, span.odometer.number, .number-sign
{
    font-size: 48px;
}
#gobierno .clearfix.tabs.page-margin-top.type-big.ui-tabs.ui-corner-all.ui-widget.ui-widget-content,
#gobierno h2.box-header{
    display: none;
}
.show-important{
    display: block !important;
}

.gallery-box img {
    filter: grayscale(1);
}



/* 1. En HOME: neutraliza estado activo automático por hash */
.home .sf-menu li.current-menu-item a[href*="#"],
.home .sf-menu li.current_page_item a[href*="#"] {
  background-color: transparent !important;
  color: inherit !important;
}

/* 2. Reactiva hover explícitamente (más específico que la regla anterior) */
.home .sf-menu li a[href*="#"]:hover {
  background-color: #348fff !important;
  color: #fff !important;
}

/* 3. Hover normal para el resto del sitio */
.sf-menu li a:hover {
  background-color: #348fff;
  color: #fff;
}

/* politicas institucionales */
.card-doc > .vc_column-inner > .wpb_wrapper {
  display: grid;
  grid-template-columns: auto 1fr;
  grid-template-rows: auto auto;
  column-gap: 20px;
  row-gap: 14px;
  align-items: center;
}

/* Los espaciadores del builder ya no se necesitan */
.card-doc > .vc_column-inner > .wpb_wrapper > .vc_empty_space {
  display: none;
}

/* Ícono: columna 1, ocupa las dos filas y se centra vertical */
.card-doc > .vc_column-inner > .wpb_wrapper > .vc_icon_element {
  grid-column: 1;
  grid-row: 1 / span 2;
  align-self: center;
  margin-bottom: 0;
}

/* Título: columna 2, fila 1 */
.card-doc > .vc_column-inner > .wpb_wrapper > .wpb_text_column {
  grid-column: 2;
  grid-row: 1;
  margin-bottom: 0;
  align-self: end;
}

.card-doc .wpb_text_column .wpb_wrapper p:last-child {
  margin-bottom: 0;
}

/* Botón: columna 2, fila 2 */
.card-doc > .vc_column-inner > .wpb_wrapper > .vc_btn3-container {
  grid-column: 2;
  grid-row: 2;
  margin-bottom: 0;
  align-self: start;
}

@media (max-width: 480px) {
  .card-doc > .vc_column-inner > .wpb_wrapper {
    column-gap: 12px;
  }
}

.vc_custom_1787153010817 {
    margin: 0 auto !important;
