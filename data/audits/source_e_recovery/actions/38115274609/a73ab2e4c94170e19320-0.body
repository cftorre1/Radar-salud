function openShadowbox(alfa){
    Shadowbox.open({
      content:    '<div id="divMilano"><form action="https://www.mutualdoc.cl/portal/index.php" method="post" target="iframename" id="myspecialform"><input type="hidden" name="r" value="' + alfa + '" /></form><iframe id="iframename" name="iframename" width="975" height="445" frameborder="0"></iframe></div>',
      player:     "html",
      width: '1000',
      height: '500',
      options : { onFinish : enviarDatosMilano } 
    });
    
    
}
function enviarDatosMilano(){
    jQuery("#divMilano form").submit()
}

function ignoreSpaces(a)
{
return a;	
}
function isNumero(a)
{
return true;
}
function validaM11(a)
{
return true;	
}
			// instruye Login
			function process() {
				var form = document.LoginForm;
				//alert(aca);
				// Datos para la autenticacion	
				var rut = form.rut.value;
				var clave = form.password.value;
				var digito = form.digito.value;
				form.j_username.value = "";
				form.j_password.value = "";
				
				if (ignoreSpaces(rut)=="") {
					alert ("Ingrese un Rut usuario");
				} else if (rut.length > 15) {
					alert ("El Rut usuario no puede superar los 15 dígitos. Ingréselo nuevamente.");
				} else if (!isNumero(rut)) {
					alert ("El Rut usuario que ingresó es incorrecto. Ingréselo nuevamente.");
				} else if (ignoreSpaces(digito)=="" ) {
					alert ("Debe ingresar el dígito verificador del Rut usuario");
				} else if (!isNumero(digito) && digito!="K"  && digito!="k") {
					alert ("El dígito verificador del Rut usuario es incorrecto. Ingréselo nuevamente.");
				} else if (!validaM11(rut,digito)) {
					alert ("El dígito verificador del Rut usuario es incorrecto. Ingréselo nuevamente.");
				} else if (ignoreSpaces(clave)=="") {
					alert ("Debe ingresar la clave");
				} else {
					// Validacion OK
					form.j_username.value = rut;
					form.j_password.value = clave;
//					setEnviroment(form);
			           		form.submit();
				}
			}

			function setEnviroment(form) {
			     $.ajax({
			           type: "POST",
			           url: "https://servicios.mutual.cl/loginPortalWeb/Setting.do",
			           data: "digito=" + form.digito.value + "&cambiaClave=" + form.cambiaClave.checked,
			           success: function (xml) {
			                // todo ok. Se activa el LOGIN
			           		form.submit();
			           }
				 });
			 }
		</script>


