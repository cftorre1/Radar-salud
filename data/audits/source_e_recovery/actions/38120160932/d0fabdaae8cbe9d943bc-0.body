}
.achs-pagination .page-number.next:hover, .achs-pagination .page-number.prev:hover {
    color: var(--secondary-color);
    max-width: 100%}
.achs-pagination .page-number.nex.disabled, .achs-pagination .page-number.prev.disabled {
    color: var(--primary-color);
