    color: var(--primary-color);
    position: relative;
    width: 100%}
.achs-pagination {
    display: flex;
    justify-content: center;
    margin: 1em auto;
    max-width: max-content;
    width: 100%}
.achs-pagination .page-numbers {
    list-style: none;
    padding: .5rem;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--white);
    border-radius: 9999px;
    box-shadow: var(--shadow);
    width: 100%;
    min-height: 50px;
}
.pag-md {
    display: none!important;
}
.achs-pagination .page-number {
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: .5s;
    text-decoration: none;
    max-width: 50%;
    min-height: 50px;
    cursor: pointer;
    margin: 0 5px;
}
.achs-pagination .num a {
