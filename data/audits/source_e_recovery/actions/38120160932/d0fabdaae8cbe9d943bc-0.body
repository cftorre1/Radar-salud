.bread{
 margin:0 !important 
}

/* BTN */

section .btn{
    font-size: 18px!important;
    font-weight: 600!important;
    border-radius: 9999px!important;
    color: #fff!important;
    padding: 10px 22px!important;
    min-height:50px!important;
    border-width: 2px!important;
    position: relative;
    border: 2px solid!important;
    transition:var(--transition) !important;
    text-decoration: none !important;
    font-family: var(--achs-sans)  !important;
    min-width: 145px;
}

section .btn:hover{
    color: #fff!important;
    text-decoration: none!important;
}

section .btn-primary{
    background-color: var(--color-primario)!important;
    border-color:var(--color-primario)!important;
}

section .btn-primary:hover{
    background-color: var(--color-secundario)!important;
    border-color:var(--color-secundario)!important;
}

section .btn-secondary{
    background-color: #fff!important;
    border-color:#fff!important;
    color:var(--color-primario)!important;
}

section .btn-secondary:hover{
    background-color: var(--color-primario-oscuro)!important;
    border-color:var(--color-primario-claro)!important;
    color:#fff!important;
}

section .btn-line{
    background-color: #fff!important;
    border-color:var(--color-primario)!important;
    color:var(--color-primario)!important;
}

/* SECTION */

.section{
    padding: 3.5rem 0;
    position: relative;
    overflow: hidden;
}

@media screen and (min-width: 1280px) {
    .section{
        padding: 4rem 0;
        overflow: visible;
    }
}

.section-title h2{
    font-size: 28px;
    margin-bottom: 20px;
    font-weight: 700;
    font-family: var(--secondary-font) !important;
}

@media screen and (min-width: 1280px) {
    .section-title h2{
        font-size: 36px;
        margin-bottom: 25px;
    }

    .section-title.-small h2{
        font-size: 32px;
    }

    .section-title.-xsmall h2{
        font-size: 28px;
    }

    .section-title.-medium h2{
        font-size: 40px;
    }

    .section-title.-big h2{
        font-size: 56px;
    }
}

.section-title.-primary h2{
    color: var(--color-primario);
}

.section-title.-secondary h2{
    color: var(--color-secundario);
}

.section-title.-center{
    text-align: center;
}

.section-title p{
    margin: 0;
    font-size: 18px;
    color: var(--color-texto-claro);
    position: relative;
}

.section-title p br{
    display: none;
}

@media screen and (min-width: 1280px) {
    .section-title p br{
        display: block;
    }
}

@media screen and (max-width: 1024px) {
    #not-found .row{
        flex-direction: column-reverse;
    }

    #not-found .section-title .btn{
        width: 100%;
    }
}

body:not(.sfPageEditor) .sec-navbar-top,
body:not(.sfPageEditor) .sec-navbar-principal,
body:not(.sfPageEditor) footer,
body:not(.sfPageEditor) .bread,
body:not(.sfPageEditor) .achsHeader,
body:not(.sfPageEditor) #footerAchsSalud,
body:not(.sfPageEditor) .cf_breadcrumb{
    display: none !important;
}

#not-found{
    min-height: 100vh;
}

@media screen and (min-width: 1024px) {
    #not-found{
        min-height: 100vh;
        display: flex;
        align-items: center;
    }

}

