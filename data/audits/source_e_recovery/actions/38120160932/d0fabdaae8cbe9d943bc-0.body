    background-color: transparent;
    font-size: 1.1rem;
    padding: 10px 20px;
    opacity: 1;
    border-radius: 99999px;
    top: 0;
    transform: unset;
    left: 0;
    right: 0;
    text-decoration: unset;
}
.achs-pagination .page-number.next .arrow, .achs-pagination .page-number.prev .arrow {
