.achs-accordion {
    max-width: 880px;
    margin: 2em auto 1em;
}
.achs-accordion .accordion-button:not(.collapsed) {
    background-color: var(--white);
    border: unset;
    box-shadow: unset;
    padding: 0;
}
.accordion-button::after, .achs-accordion .accordion-button:not(.collapsed)::after {
    background-image: none;
}
.achs-accordion .accordion-item .accordion-button.collapsed {
    width: 100%;
    padding-top: 0;
    padding-left: 0;
}
.achs-accordion .accordion-item {
    border: unset;
    display: flex;
    flex-direction: column;
    align-items: baseline;
    position: relative;
    background-color: transparent;
}
.achs-accordion .box-btn {
    margin-top: 1em;
    display: flex;
    justify-content: flex-end;
    width: 100%}
.achs-accordion .accordion-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 50px;
    height: 48px;
    border-radius: 99999px;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
}
.achs-accordion .accordion-item::after {
    content: "";
    width: 2px;
    height: 100%;
    display: block;
    position: absolute;
    top: 0;
    left: 22px;
}
.achs-accordion .accordion-item.disabled::after, .achs-accordion .accordion-item.disabled::before {
    background-color: var(--gray-line);
}
.achs-accordion .accordion-item:last-child::after {
    top: -17px;
    height: 89%}
.achs-accordion .accordion-item .accordion-button .cont-text span {
    font-size: 18px;
    color: var(--gray-dark);
    position: absolute;
    left: -40px;
    right: 0;
    width: 14px;
    height: 20px;
    top: 0;
    z-index: 2;
    font-family: var(--primary-font);
}
.achs-accordion .accordion-item.check .accordion-button .cont-text span i {
