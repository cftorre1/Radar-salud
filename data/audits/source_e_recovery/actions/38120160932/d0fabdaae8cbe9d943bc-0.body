.type-switch {
    background-color: var(--gray-disabled);
    border: 1px solid var(--gray-line);
    padding: .8rem;
    width: max-content;
    border-radius: 99999px;
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
}
.type-switch .btn-switch {
    color: var(--primary-color);
    background-color: transparent;
    font-size: 1.1rem;
    font-family: AchsNuevaSansBold;
    border-radius: 99999px;
    padding: .8rem 1.5rem;
    border: none;
    transition-duration: .3s;
    position: relative;
    z-index: 1;
}
.type-switch .btn-switch.active::after {
    content: "";
    display: block;
    width: 95%;
    height: 52px;
    position: absolute;
    top: 0;
    z-index: -1;
    border-radius: 99999px;
    background-color: var(--primary-color);
}
.type-switch #element_presencial.btn-switch.active::after, .type-switch .btn-switch:first-child.active::after {
    animation: .5s linear forwards rot1;
}
.type-switch #element_online.btn-switch.active::after, .type-switch .btn-switch:last-child.active::after {
    animation: .5s linear forwards rot2;
}
@keyframes rot1 {
    0% {
    -webkit-transform: translateX(0);
    -ms-transform: translateX(0);
    transform: translateX(0);
}
100% {
    -webkit-transform: translateX(-20px);
    -ms-transform: translateX(-20px);
    transform: translateX(-20px);
}
}@keyframes rot2 {
    0% {
    -webkit-transform: translateX(-100px);
    -ms-transform: translateX(-100px);
    transform: translateX(-100px);
}
100% {
    -webkit-transform: translateX(-20px);
    -ms-transform: translateX(-20px);
    transform: translateX(-20px);
}
}.achs-nav-h .btn-switch:first-child, .achs-nav-h .btn-switch:last-child {
    border-radius: 99999px;
}
