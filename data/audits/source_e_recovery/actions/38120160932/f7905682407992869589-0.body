<style>
/* =========================================================
   CHATBOT MUTUAL
   ========================================================= */

.chatbot-mutual *{
    box-sizing: border-box;
}

/* =========================================================
   BOTON FLOTANTE
   ========================================================= */

.chatbot-mutual .button-action-carrusel{
    position: fixed;
    right: 16px;
    bottom: 8px;
    z-index: 100;
}

.chatbot-mutual .button-fill-primary{
    width: 56px;
    height: 56px;
    box-shadow:
        0px 0px 1px 0px rgba(16, 22, 42, 0.04),
        0px 2px 4px 0px rgba(122, 122, 122, 0.16);
}

.chatbot-mutual .button-fill-primary span.icon-action{
    font-size: 25px;
    top: 2px;
    position: relative;
}

.chatbot-mutual .btn-open-chatbot{
    position: fixed;
    z-index: 99999;
    bottom: 10px;
    right: 60px;
    transition: all 300ms ease;
}

/* Imagen botón flotante */
.chatbot-button-img{
    width: 65px;
    height: 65px;
    cursor: pointer;
    transition:
        transform 0.3s ease,
        box-shadow 0.3s ease,
        filter 0.3s ease;
    position: fixed;
    bottom: 25px;
    right: 25px;
    z-index: 9999;
}

.chatbot-button-img:hover{
    transform: scale(1.05);
    filter: brightness(1.1);
}

/* =========================================================
   MASK
   ========================================================= */

.mask-chat-bot{
    background: rgba(0,0,0,0.45);
    position: fixed;
    inset: 0;
    display: none;
    z-index: 999999998;
}

/* =========================================================
   CONTENEDOR CHATBOT
   ========================================================= */

.chatbot-mutual .contenedor-chatbot{
    position: fixed;
    bottom: 0;
    right: 0;

    width: 320px;
    height: 475px;

    background: #ffffff;

    z-index: 999999999;

    border-radius: 14px 14px 0 0;
    overflow: hidden;

    box-shadow:
        0 8px 30px rgba(0,0,0,0.18);

    display: flex;
    flex-direction: column;

    transform: translateX(100%);
    transition: transform 300ms ease;
}

.chatbot-mutual .contenedor-chatbot.chatbot-open{
    transform: translateX(0);
}
/* =========================================================
   HEADER
   ========================================================= */

.chatbot-mutual .contenedor-chatbot .header-chatbot{
    position: relative;

    height: 72px;

    background: linear-gradient(
        90deg,
        rgba(5,65,156,1) 16%,
        rgba(2,6,17,1) 100%
    );

    color: #ffffff;

    font-family: Lato, Arial, sans-serif;
    font-size: 18px;
    font-weight: 600;

    text-align: center;
    line-height: 72px;
	
	flex: 0 0 72px;
}

.chatbot-mutual .contenedor-chatbot .header-chatbot img.logo-chatbot{
    position: absolute;
    top: 12px;
    left: 10px;

    width: 46px;
    height: auto;
}

.chatbot-mutual .contenedor-chatbot .header-chatbot img.close-chatbot{
    position: absolute;
    top: 18px;
    right: 12px;

    width: 34px;
    height: 34px;

    cursor: pointer;
}

/* =========================================================
   IFRAME
   ========================================================= */

.chatbot-mutual .contenedor-chatbot iframe{
    border: none;

    width: 100%;

    flex: 1 1 auto;

    height: auto;
    min-height: 0;

    display: block;
}

/* =========================================================
   DESKTOP GRANDE
   >= 1024px
   ========================================================= */

@media (min-width: 1024px){

    .chatbot-mutual .contenedor-chatbot{
        width: 320px;
        height: 475px;
    }

    .chatbot-mutual .contenedor-chatbot iframe{
        min-height: 0;
    }
}

/* =========================================================
   TABLET
   768px - 1023px
   ========================================================= */

@media (min-width: 768px) and (max-width: 1023px){

    .chatbot-mutual .contenedor-chatbot{
        width: 300px;
        height: 445px;
    }

    .chatbot-mutual .contenedor-chatbot iframe{
        min-height: 0;
    }

    .chatbot-button-img{
        width: 60px;
        height: 60px;
    }
}

/* =========================================================
   MOBILE
   <= 767px
   ========================================================= */

@media (max-width: 767px){

    .chatbot-mutual .contenedor-chatbot{
        width: calc(100vw - 16px);
        max-width: 360px;

        height: min(78dvh, 520px);

        right: 0;
        bottom: 0;

        border-radius: 14px 14px 0 0;
    }

	.chatbot-mutual .contenedor-chatbot iframe{
		flex: 1 1 auto;
		min-height: 0;
	}

    .chatbot-mutual .contenedor-chatbot .header-chatbot{
        height: 68px;
        line-height: 68px;
        font-size: 16px;
		flex: 0 0 68px;
    }

    .chatbot-mutual .contenedor-chatbot .header-chatbot img.logo-chatbot{
        width: 42px;
        top: 12px;
    }

    .chatbot-mutual .contenedor-chatbot .header-chatbot img.close-chatbot{
        width: 30px;
        height: 30px;
        top: 18px;
    }

    .chatbot-button-img{
        width: 56px;
        height: 56px;
        right: 16px;
        bottom: 16px;
    }

    .chatbot-mutual .button-action-carrusel{
        right: 8px;
        bottom: 8px;
    }

    .chatbot-mutual .button-fill-primary{
        width: 48px;
        height: 48px;
    }

    .chatbot-mutual .button-fill-primary span.icon-action{
        font-size: 21px;
    }
}

/* =========================================================
   MOBILE PEQUEÑO
   <= 480px
   ========================================================= */

@media (max-width: 480px){

    .chatbot-mutual .contenedor-chatbot{
        width: 100vw;
		max-width: none;

        height: 100dvh;
        max-height: 100dvh;

        right: 0;
        bottom: 0;

        border-radius: 0;
    }

    .chatbot-mutual .contenedor-chatbot iframe{
        height: auto;
        min-height: 0;
    }
}

@supports not (height: 100dvh){

    @media (max-width: 480px){

        .chatbot-mutual .contenedor-chatbot{
            height: 100vh;
            max-height: 100vh;
        }

    }

}

</style>
<div class="chatbot-mutual">
        <a href="#." onclick="openChatbot(); return false;">
 <img src="/portal/wcm/connect/434cc227-4f44-48c9-b8dd-ca224b3018bf/chat-burbuja-iso.png?MOD=AJPERES&amp;CACHEID=ROOTWORKSPACE-434cc227-4f44-48c9-b8dd-ca224b3018bf-pFfcKC9" alt="Abrir Chatbot Mutual"  class="chatbot-button-img" />
</a>
        <div class="mask-chat-bot"></div>
        <div class="contenedor-chatbot">
            <div class="header-chatbot">
                <img src="/portal/wcm/connect/434cc227-4f44-48c9-b8dd-ca224b3018bf/chat-burbuja-iso.png?MOD=AJPERES&amp;CACHEID=ROOTWORKSPACE-434cc227-4f44-48c9-b8dd-ca224b3018bf-pFfcKC9" alt="Isotipo Chatbot"  class="logo-chatbot" />
                MUTUALIA
                <a href="#." onclick="closeChatbot(); return false;">
                    <img src="/portal/wcm/connect/a6b56793-ea70-47f1-8d43-cc90abc40c74/close-chatbot.png?MOD=AJPERES&amp;CACHEID=ROOTWORKSPACE-a6b56793-ea70-47f1-8d43-cc90abc40c74-ngIrwjh" alt="Botón Cerrar Chatbot"  class="close-chatbot" />
                </a>
            </div>
            <iframe id="chatbotiframe"  title="ChatBot de Mutual"></iframe>
        </div>
    </div>


<script>

var btnOpenChatbot = document.querySelector('.chatbot-button-img')
var chatBot = document.querySelector('.contenedor-chatbot')
var mascaraNegra = document.querySelector('.mask-chat-bot')

function openChatbot(){
    if(jQuery('#chatbotiframe').prop('src') == "" || jQuery('#chatbotiframe').prop('src') == null){


     jQuery('#chatbotiframe').prop('src','https://prodeus2cappbff01.agreeablewave-d8d9de06.eastus2.azurecontainerapps.io/portal/demo/publico')


}
     
chatBot.classList.add('chatbot-open');

btnOpenChatbot.style.opacity = '0';
btnOpenChatbot.style.pointerEvents = 'none';

mascaraNegra.style.display = 'block';
}

function closeChatbot(){

    chatBot.classList.remove('chatbot-open');

    btnOpenChatbot.style.opacity = '1';
    btnOpenChatbot.style.pointerEvents = 'auto';

    mascaraNegra.style.display = 'none';
}

var url = window.location.href;

if(url.search('/landing-covid/')!= -1){

var eElement = jQuery('.chatbot-mutual');
var newFirstElement = jQuery('.nav-covid-web');

eElement.insertBefore(newFirstElement, eElement.firstChild);

}else{

var eElement = jQuery('.chatbot-mutual');
var newFirstElement = jQuery('#myMenu');

eElement.insertBefore(newFirstElement, eElement.firstChild);

}
</script>


<script>
(function () {
  var iframe = [...document.querySelectorAll("iframe")].find(f => /cappbff01/.test(f.src));
  if (!iframe || !iframe.src) return;

  var u = new URL(iframe.src);
  u.searchParams.delete("xref");
  var ORIGIN = u.origin;

  function leerCookie(n){var m=document.cookie.match(new RegExp("(?:^|; )"+n+"=([^;]*)"));return m?decodeURIComponent(m[1]):"";}

  window.addEventListener("message", function(event) {

    if (event.origin !== "https://prodeus2cappbff01.agreeablewave-d8d9de06.eastus2.azurecontainerapps.io") {
        return;
    }

    if (event.data && event.data.tipo === "SET_COOKIE") {
        document.cookie =
            `${event.data.nombre}=${encodeURIComponent(event.data.valor)}; path=/; max-age=31536000`;
        console.log("Cookie creada :white_check_mark:", event.data.valor);
    }
});

  var xref = leerCookie("mtl_xref");
  if (xref) { u.searchParams.set("xref", xref); iframe.src = u.toString(); }
})();
</script>
<script>
window.onload = function () {
console.log("onload");
    const nombreCookie = "mtl_xref";

    const valor = document.cookie
        .split("; ")
        .find(row => row.startsWith(nombreCookie + "="))
        ?.split("=")[1];

    console.log(
        valor
            ? decodeURIComponent(valor)
            : "Cookie no encontrada"
    );
};
</script>
