  });

  jQuery('.sub-link a.bg-link-active').each(function() {
    var parentLink = jQuery(this).closest('.link.has-submenu');      
    if (!parentLink.hasClass('expanded')) {
      parentLink.addClass('expanded');
    }
  });

});

function toggleSubmenu(element) {
  const parent = element.closest('.link');
  parent.classList.toggle('expanded');
}

    document.addEventListener('DOMContentLoaded', recalcularMenu);
    window.addEventListener('resize', recalcularMenu);
    
    function recalcularMenu() {
      const contenedor = document.querySelector('div.component-container.wpthemeLeft.wpthemeCol8of12');
      const menu = document.querySelector('nav.submenu');
      if (!contenedor || !menu) return;
      
      const limiteVH = window.innerHeight * 0.60;
      const alturaContenedor = contenedor.offsetHeight;
  
      if (alturaContenedor < limiteVH) {
        menu.style.maxHeight = limiteVH + 'px';
        menu.style.overflowY = 'auto';
      } else {
        menu.style.maxHeight = alturaContenedor + 'px';
        menu.style.overflowY = 'auto';
      }
    }

window.addEventListener("load", () => {
  const target = document.querySelector(
    'table.layoutRow.ibmDndRow.component-container > tbody > tr > td:last-of-type > table > tbody'
  );
  const submenu = document.querySelector('.submenu');

  if (target && submenu) {
    const actualizarAltura = () => {
      const nuevaAltura = target.offsetHeight - 1;
      submenu.style.height = nuevaAltura + "px";
    };

    // Ejecuta una vez al cargar todo
    actualizarAltura();

    // Observa cambios dinámicos posteriores
    const observer = new ResizeObserver(() => {
      actualizarAltura();
    });
    observer.observe(target);
  }
});

</script>
        
        
    

    
        





        







    
