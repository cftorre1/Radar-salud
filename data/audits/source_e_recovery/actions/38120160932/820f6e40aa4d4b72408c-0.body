<script type="text/javascript">
let originalFontSize = 16;

// Elementos alterables del DOM.
const domElements =
    "a:not(.not-resize),p:not(.not-resize),span:not(.not-resize),h1:not(.not-resize),h2:not(.not-resize),h3:not(.not-resize),h4:not(.not-resize),h5:not(.not-resize),h6:not(.not-resize)";
/**
 * Cambiar tamaño de texto
 */

let sizeStep = 4;

// Cantidad de pasos para alterar el texto - 4 es default.
// const stepnum = 3;
// const initialFontSize = (el) => {
//     let element = document.querySelectorAll(el);

//     element.forEach((el) => {
//         let style = getComputedStyle(el);
//         let fontNum = style.fontSize.replace("px", "");

//         console.log(fontNum);
//     });
// };
// initialFontSize(domElements);
/** Aumentar tamaño */
/** Aumentar tamaño */
const upFontSize = (el, currentStep) => {
    let element = document.querySelectorAll(el);

    element.forEach((el) => {
        let style = getComputedStyle(el);
        let fontNum = parseFloat(style.fontSize.replace("px", ""));

        let newCss = parseFloat(fontNum + currentStep);

        el.style.fontSize = `${newCss}px`;
    });
};

/** Disminuir tamaño */
const downFontSize = (el, currentStep) => {
    let element = document.querySelectorAll(el);

    element.forEach((el) => {
        let style = getComputedStyle(el);
        let fontNum = parseFloat(style.fontSize.replace("px", ""));

        let newCss = parseFloat(fontNum - currentStep);

        el.style.fontSize = `${newCss}px`;
    });
};

// Función de incremento
const increaseFontSize = () => {
    if (sizeStep < 7) {
        sizeStep++;
        upFontSize(domElements, 3);
    }
};

// Función de decremento
const decreaseFontSize = () => {
    if (sizeStep > 1) {
        sizeStep--;
        downFontSize(domElements, 3);
    }
};

// Función para restablecer el tamaño de fuente original
// Función para obtener el tamaño de fuente original
const getOriginalFontSize = () => {
    let sampleElement = document.querySelector(domElements);
    if (sampleElement) {
        originalFontSize = parseFloat(getComputedStyle(sampleElement).fontSize);
    } else {
        console.error("No se pudo encontrar un elemento de muestra para obtener el tamaño de fuente original.");
    }
};


const resetFontSize = () => {
    if (originalFontSize !== 0) {
        let elements = document.querySelectorAll(domElements);

        elements.forEach((el) => {
            el.style.fontSize = originalFontSize + 'px';
        });
    } else {
        console.error("El tamaño de fuente original no se ha inicializado correctamente.");
    }
};
/**
 * FIN Cambiar tamaño de texto
 */

/**
 * Destacar Elementos
 */
const highlightObjects = (el) => {
    let element = document.querySelectorAll(el);

    element.forEach((el) => {
        el.classList.toggle("hl-objects");
    });
};




document.addEventListener("DOMContentLoaded", function () {

    _accesibilidad();

});

function _accesibilidad() {
    const increaseBtn = document.querySelector("#agrandar");
    const decreaseBtn = document.querySelector("#disminuir");
    const contrastBtn = document.querySelector("#contraste");
    const lineaBtn = document.querySelector("#lectura");
    const resaltarBtn = document.querySelector("#resaltar");
    const cursorBtn = document.querySelector("#cursor");
    const audioBtn = document.querySelector("#audio-lectura");
    increaseBtn.addEventListener("click", (e) => {
        e.preventDefault();
        increaseFontSize();
    });
    decreaseBtn.addEventListener("click", (e) => {
        e.preventDefault();
        decreaseFontSize();
    });
    contrastBtn.addEventListener("click", (e) => {
        e.preventDefault();
        document.querySelector("body").classList.toggle("high-contrast-for-all");
        document.querySelector("header").classList.toggle("high-contrast");
        document.querySelector("footer").classList.toggle("high-contrast");
        document.querySelector("#assistArea").classList.toggle("high-contrast");
        document.querySelector(".menu-responsive").classList.toggle("high-contrast");
        contrastBtn.classList.toggle("active-btn");
    });
    lineaBtn.addEventListener("click", (e) => {
        e.preventDefault();
        document.querySelector(".cursor").classList.toggle("activo");
        lineaBtn.classList.toggle("active-btn");
    });
    resaltarBtn.addEventListener("click", (e) => {
        e.preventDefault();
        highlightObjects(domElements);
        resaltarBtn.classList.toggle("active-btn");
    });
    cursorBtn.addEventListener("click", (e) => {
        e.preventDefault();
        document.body.classList.toggle("new-cursor");
        cursorBtn.classList.toggle("active-btn");
    });
    const cursorHL = document.querySelector(".hl");

    document.addEventListener("mousemove", (e) => {
        cursorHL.setAttribute("style", `top: ${e.clientY}px;`);
    });


    const restoreDefaults = () => {

        // Restaurar los cambios de alto contraste
        document.querySelector("header").classList.remove("high-contrast");
        document.querySelector("footer").classList.remove("high-contrast");
        document.querySelector("body").classList.remove("high-contrast-for-all");
        // document.querySelector("#assist-area").classList.remove("high-contrast");
        // document.querySelector(".menu-responsive").classList.remove("high-contrast");
        contrastBtn.classList.remove("active-btn");

        // Restaurar la línea de lectura y el resaltado
        document.querySelector(".cursor").classList.remove("activo");
        lineaBtn.classList.remove("active-btn");

        const elementsWithHighlight = document.querySelectorAll('.hl-objects');
        elementsWithHighlight.forEach((el) => {
            el.classList.remove('hl-objects');
        });

        resaltarBtn.classList.remove("active-btn");

        // Restaurar el cursor personalizado
        document.body.classList.remove("new-cursor");
        cursorBtn.classList.remove("active-btn");

    }
    const restoreContrast = () => {
        // Restaurar los cambios de alto contraste
        document.querySelector("header").classList.remove("high-contrast");
        document.querySelector("footer").classList.remove("high-contrast");
        document.querySelector("body").classList.remove("high-contrast-for-all");
    }



    const resetBtn = document.querySelector("#restablecer");
    resetBtn.addEventListener("click", (e) => {
        // e.preventDefault();
        restoreDefaults();
        resetFontSize();
        console.log('original:' + originalFontSize)
        console.log('reestablecer')
    });
    const resetContrast = document.querySelector("#contraste2");
    resetContrast.addEventListener("click", (e) => {
        restoreContrast();
        console.log('contraste off')
    });

    // audioBtn.addEventListener('click', (e) => {
    //     e.preventDefault();
    //     document.querySelector('#__ba_floatingLaunch > button').click();
    // })
}
</script>

<script type="text/javascript">
function _fixBreadcrumb() {
    let _breadcrumb = document.querySelector(".cf_breadcrumb");
    if (window.location.pathname == "/") {
        _breadcrumb.classList.add("d-none");
    }
    else {
        _breadcrumb.classList.remove("d-none");
    }
}
_fixBreadcrumb();
</script>



<script type="text/javascript">
  var lazyLoadInstance = new LazyLoad({
    elements_selector: ".lazy"
  });
</script>

<script type="text/javascript">
console.log("cf");
//_isLoadind(true, "init");


///
const _nameFilter = "filter_";
const _nameCountItem = "count_";
const _idContainerItem = "cf_listItem";
const _classItems = "cf_item";
const _idFilterApplied = "cf_filterApplied";
const _idLimpiarFiltros = "clearForm";

const _data = "_data";
const _idContadorItem = "cf_contadorItem";
const _idContainerPaginador = "cf_paginador";
const _idPaginaActual = "cf_paginaActual";
const _classPaginas = "cf_paginas";
const _idTotalPaginas = "cf_totalPaginas";
const _idBtnPaginaSiguiente = "cf_paginaSiguiente";
const _idBtnPaginaAnterior = "cf_paginaAnterior";

const _idSearch = "materialesSearch";
const _idBtnSearch = "cf_btnSearch";


const _idContainerCheckbox_Formatos = "checkbox_Formatos";

const _idContainerDiv_divclicables = "listItem_divclicables";
const _idContainerCheckbox_divclicables = "checkbox_divclicables";
///

///

//variables filtro
let listFiltersApplied = [];
let listItems = [];
let listDisplayData = [];
//variables paginador
let paginaActual = 0;
let listPagina = [];
//variables  count
let listIdSpanCount = [];


/// list consultas async
///
init();
// (function () {
//     init();
// })();
///

//#region consultas async

async function GetClassificationApi(id) {
    //_isLoadind(true, `GetClassificationApi_${id}`);
    const _url = `${_urlClassificationApi} ${id}`;
    let _result = {
        data: [],
        status: 0,
        mensaje: "",
    };

    var myHeaders = new Headers();
    myHeaders.append("Content-Type", "application/json");

    var requestOptions = {
        method: 'GET',
        headers: myHeaders
    };

    try {
        let response = await fetch(_url, requestOptions);
        let result = await response.json();
        console.log(result);

        _result.data = result.value;
        _result.status = response.status;
        _result.mensaje = "";
    } catch (error) {
        console.log(error);
        _result.mensaje = error;
    } finally {
        //_isLoadind(false, `GetClassificationApi_${id}`);
    }
    return _result;
}

//#endregion

///

//#region Data

// busca los elementos y crea una lista de objetos
function GetListItem() {
    let _listItems = document.querySelectorAll('.cf_item');
    if (_listItems == null) { return resoult; }
    //_isLoadind(true, "GetListItem");

    let countItem = 0;
    _listItems.forEach(element => {
        element.id = `${_classItems}${countItem}`;
        let item = {
            navigateUrl: element.querySelector(".navigateUrl").textContent,
            LastModified: element.querySelector(".LastModified").textContent,
            PublicationDate: element.querySelector(".PublicationDate").textContent,
            DateCreated: element.querySelector(".DateCreated").textContent,
            UrlName: element.querySelector(".UrlName").textContent,
            sortLastModified: element.querySelector(".sortLastModified").textContent,
            sortPublicationDate: element.querySelector(".sortPublicationDate").textContent,
            sortDateCreated: element.querySelector(".sortDateCreated").textContent,

            Title: element.querySelector(".Title").textContent,
            Contenido: element.querySelector(".Contenido").textContent,
            InfoRelevante: element.querySelector(".InfoRelevante").textContent,
            ImagePrincipal: element.querySelector(".ImagePrincipal").textContent,
            LeyendaImagePrincipal: element.querySelector(".LeyendaImagePrincipal").textContent,
            Resume: element.querySelector(".Resume").textContent,
            TiempoLectura: element.querySelector(".TiempoLectura").textContent,
            TitleSecundario: element.querySelector(".TitleSecundario").textContent,
            NombreAutor: element.querySelector(".NombreAutor").textContent,
            InfoAutor: element.querySelector(".InfoAutor").textContent,
            FechaArticulo: element.querySelector(".FechaArticulo").textContent,

            listClassification: GetClassification(element.querySelector(".listClassification")),

            NodeHtml: element,
            id: `${_classItems}-${countItem}`,
        };
        item.Html = CreateHtmlItem(item);
        item.AllFilter = GetAllClassification(item.listClassification);

        countItem++;
        listItems.push(item);
    });
    //_isLoadind(false, "GetListItem");
}

// create objeto con las clasificaciones
function GetClassification(list) {
    let resoult = {
        categoriasblogsnl: GetElementLi(list.querySelector(".categoriasblogsnl")),
    };
    return resoult;
}

// crea lista de todas las clasificaciones
function GetAllClassification(classification) {
    let resoult = [];
    let claves = Object.keys(classification);
    claves.forEach(function (element, indice, array) {
        let clave = claves[indice];
        (classification[clave]).forEach(elementII => {
            resoult.push(elementII.urlName);
        });
    });
    return resoult;
}

// list es el ul que contiene el o los li que corresponden a las clasificaciones
function GetElementLi(list) {
    let _list = list.querySelectorAll("li");
    let resoult = [];
    _list.forEach(element => {
        resoult.push({ urlName: element.dataset.flattaxon, title: element.textContent });
    });
    return resoult;
}

// crea el html que se va a renderizar
function CreateHtmlItem(item) {
    let html = `
        <div id="${item.id}" class="col-lg-4 col-md-6 col-sm-12">
            <div class="card achs-card card-news -salud">
                <div class="card-img">
                    <img src="${item.ImagePrincipal}" class="lazy entered loaded" alt="Encuentra la postura correcta para trabajar frente al computador" loading="lazy" data-ll-status="loaded">
                </div>                            
                <div class="card-body">
                    <h5>${item.Title}</h5>
                    <p class="card-text">${item.Resume}…</p>
                    <span class="d-block mb-3"><strong>Escrito por:</strong> ${item.NombreAutor}</span>
                    <span class="time d-block"><i class="bi bi-clock"></i> <small>${item.TiempoLectura} minutos de lectura</small> </span>
                    <div class="box-action">
                        <a href="${item.navigateUrl}" class="" title="${item.Title}">Leer artículo</a>
                    </div>
                </div>
            </div>
        </div>
    `;
    return html;
}

// corta una cadena de string dependiendo la logitud enviada
function GetResumen(data, length) {
    if (data.length > length) {
        return `${data.substring(0, length)}...`;
    }
    return data;
}

//#endregion

///

//#region filtros

function BtnOnclick(elemento) {
    const idBtn = elemento.id;
    const idCheckBox = idBtn.replace("btn_", _nameFilter);
    const checkBox = document.querySelector(`#${idCheckBox}`);
    if (checkBox == null) { return; }

    checkBox.checked = !checkBox.checked;
    if (checkBox.checked) {
        elemento.classList.add("active");
    }
    else {
        elemento.classList.remove("active");
    }
    FiltrarData(checkBox);
}

function FiltrarData(element) {
    if (element.checked) {
        AplicarFiltro(element);
    } else {
        RemoveFiltro(element);
    }
    _Filter();
}

function _Filter() {
    //inclusivo
    //let dataFilter = listItems.filter(x => isInclusive(x.AllFilter, listFiltersApplied));
    //exclusivo
    let dataFilter = listItems.filter(x => isExclusive(x.AllFilter, listFiltersApplied));

    if (listFiltersApplied.length == 0) {
        dataFilter = listItems;
    }

    //CheckedRelevanteFiltro(element);
    //document.querySelector(`#${_idSearch}`).value = "";
    document.querySelector(`#${_idContainerItem}`).scrollIntoView();
    Order(dataFilter);
    Paginar();
    SetCount();
}

function AplicarFiltro(element) {
    let _filtro = (element.id).replace(_nameFilter, "");
    if (listFiltersApplied.includes(_filtro)) { return; }
    // //se se desea agregr un listados de filtroa aplicados aqui va el codigo para agregar
    // let html = `
    //     <button id="${_nameNameFilter}${_filtro}" onclick="UnCheckedFilterApplied('${element.id}')" class="products-filter-remove-btn">${element.dataset.title}</button>
    // `;
    // document.querySelector(`${_idFilterApplied}`).insertAdjacentHTML('beforeend', html);
    listFiltersApplied.push(_filtro);
}

function RemoveFiltro(element) {
    let _filtro = (element.id).replace(_nameFilter, "");
    if (!listFiltersApplied.includes(_filtro)) { return; }
    // //si hay un listados de filtroa aplicados aqui va el codigo codogo para borrar
    // (document.querySelector(`${_idFilterApplied}`)).querySelector(`#${_nameNameFilter}${_filtro}`).remove();
    listFiltersApplied.splice(listFiltersApplied.indexOf(_filtro), 1);
}

//todos los elementos de target estan dentro de list
function isExclusive(list, target) {
    return target.every(x => list.includes(x));
}

//alguno de los elementos de target estan dentro de list
function isInclusive(list, target) {
    return target.some(x => list.includes(x));
}

const _btlClearFilter = document.querySelector(`#${_idLimpiarFiltros}`);
if (_btlClearFilter != null) {
    _btlClearFilter.addEventListener('click', function (event) {
        RemoveAllFiltros();
    });
}
//elimina todos los filtros aplicados
function RemoveAllFiltros() {
    document.querySelectorAll('input[type="checkbox"]:checked').forEach(element => {
        element.checked = false;
        FiltrarData(element);
    });
}


//elimina del listado de filtros aplicados
function UnCheckedFilterApplied(id) {
    let filtro = document.querySelector(`#${id}`);
    filtro.checked = false;
    FiltrarData(filtro);
}

//se encarga de marcar seleccionado si hay filtros relevantes o recomendados
function CheckedRelevanteFiltro(element) {
    let relevanteFiltro = document.querySelector(`#cf_${element.id}`);
    if (relevanteFiltro != null) {
        if (element.checked) {
            relevanteFiltro.classList.add('btnActive');
        } else {
            relevanteFiltro.classList.remove('btnActive');
        }
    }

    if (listFiltersApplied.length > 0) {
        document.querySelector('#cf_sinFiltro').classList.remove("btnActive");
    } else {
        document.querySelector('#cf_sinFiltro').classList.add("btnActive");
    }
}

//#endregion

///

//#region Reordenamiento

let _orderBy = document.querySelector("#orderBy");
if (_orderBy != null) {
    _orderBy.addEventListener('change', function (event) {
        Order(listDisplayData);
        Paginar();
        GotoPage(paginaActual);
    });
}

function Order(data) {
    let containerItems = document.querySelector(`#${_idContainerItem}`);
    containerItems.innerHTML = "";

    listDisplayData = data.slice();

    let select = document.querySelector('#orderBy');
    let order = "desc";
    if (select != null && select.order != "Selecciona") {
        order = select.order;
    }

    listDisplayData.sort(OrderBy("sortLastModified", order));
}

// ordena por propiedades alfaveticamente o numericamente
function OrderBy(key, order = "desc") {
    return function innerSort(a, b) {
        if (!isPropertyOrder(key, a, b)) { return 0; }

        let _result = 0;
        let _valA = (typeof a[key] === 'string') ? StrNormalize(a[key]) : a[key];
        let _valB = (typeof b[key] === 'string') ? StrNormalize(b[key]) : b[key];
        if (order == "asc") {
            let _value = parseInt(_valA - _valB);
            _result = (isNaN(_value)) ? _valA.localeCompare(_valB) : _value;
        } else {
            let _value = parseInt(_valB - _valA);
            _result = (isNaN(_value)) ? _valB.localeCompare(_valA) : _value;
        }
        return _result;
    };
}

// ordena desc por una propiedad bool y si ambos elementos son ciertos ordena por sortLastModified
function OrderByBool(key) {
    return function innerSort(a, b) {
        if (!isPropertyOrder(key, a, b)) { return 0; }

        let _result = 0;
        let isEqual = (a.Home === b.Home);
        if (isEqual) {
            _result = parseInt(b.sortLastModified - a.sortLastModified);
        }
        else {
            if (a.Home) {
                _result = -1;
            }
            else {
                _result = 1;
            }
        }
        return _result;
    };
}

// revisa si la propiedad se encuentra en los objetos
function isPropertyOrder(key, a, b) {
    if (!a.hasOwnProperty(key) || !b.hasOwnProperty(key)) {
        console.log(`no se encuentra la propiedad ${key} en el listado de objeto`);
        return false;
    }
    return true;
}
//#endregion

///

//#region Paginar

let _pageActual = document.querySelector(`#${_idPaginaActual}`);
if (_pageActual != null) {
    _pageActual.addEventListener('change', function (event) {
        let value = event.target.value;
        var rexp = new RegExp(/^([0-9])+$/);

        if (!value.match(rexp)) {
            event.target.value = paginaActual;
            return;
        }

        GotoPage((parseInt(event.target.value) - 1));
    });
}

function Paginar() {
    paginaActual = 0;
    listPagina = [];
    let pagina = [];
    let maxiElemectPage = 9; // cada pagina debe ser de 9

    listDisplayData.forEach(function (element, indice, array) {
        pagina.push(element);
        if (pagina.length == maxiElemectPage || indice == (listDisplayData.length - 1)) {
            listPagina.push(pagina);
            pagina = [];
        }
    });

    //insert html de la pagina actual
    let containerItems = document.querySelector(`#${_idContainerItem}`);
    listPagina.forEach(function (pagina, indice, array) {
        if (paginaActual == indice) {
            pagina.forEach(element => {
                containerItems.insertAdjacentHTML('beforeend', `${element.Html}`);
            });
        }
    });

    //contador de item a mostrar
    //document.querySelector(`#${_idContadorItem}`).innerHTML = listDisplayData.length;
    CreateHtmlPaginador();
}

function CreateHtmlPaginador() {
    let paginador = document.querySelector(`#${_idContainerPaginador}`);
    if (paginador == null) { return; }

    let paginas = "";
    listPagina.forEach(function (element, indice, array) {
        let _isActive = "";
        if (paginaActual == indice) { _isActive = "active"; }
        paginas += `
            <li onclick="GotoPage(${indice})" data-pagina="${indice}" class="page-number ${_isActive} ${_classPaginas}"><a href="javascript:(0)" class="arrow">${(indice + 1)}</a></li>
        `;
    });

    paginador.innerHTML = "";
    paginador.insertAdjacentHTML('beforeend', `
        <div class="achs-pagination mt-4 pag-desk">
            <ul class="page-numbers">
                <li onclick="GotoBackPage()" class="${_idBtnPaginaAnterior} page-number prev">
                    <button type="button" class="arrow">
                        <i class="bi bi-chevron-left"></i>Anterior
                    </button>
                </li>
                ${paginas}
                <li id="" onclick="GotoNextPage()" class="${_idBtnPaginaSiguiente} page-number next">
                    <button type="button" class="arrow">Siguiente
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </li>
            </ul>
        </div>
        <div class="achs-pagination mt-4 pag-md">
            <ul class="page-numbers splide__arrows">
                <li id="" onclick="GotoBackPage()" class="${_idBtnPaginaAnterior} page-number prev">
                    <button type="button" class="arrow">
                        <i class="bi bi-chevron-left"></i>Anterior
                    </button>
                </li>
                <li class="d-flex num">
                    <span id="${_idPaginaActual}" >${(paginaActual + 1)}</span>/<span id="${_idTotalPaginas}">${listPagina.length}</span>
                </li>
                <li onclick="GotoNextPage()" class="${_idBtnPaginaSiguiente} page-number next">
                    <button type="button" class="arrow">Siguiente
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </li>
            </ul>
        </div>
    `);

    CheckBtnBackNext();
}

function GotoPage(index) {
    document.querySelector(`#${_idContainerItem}`).scrollIntoView();
    if (index < 0 || index > (listPagina.length - 1)) { return; }
    paginaActual = index;
    listPagina.forEach(function (element, indice, array) {
        if (index == indice) {
            MostrarElementosPagina(element);
        } else {
            OcultarElementosPagina(element);
        }
    });

    CheckBtnBackNext();
}

function GotoBackPage() {
    GotoPage(paginaActual - 1);
}

function GotoNextPage() {
    GotoPage(paginaActual + 1);
}

function OcultarElementosPagina(data) {
    data.forEach(element => {
        let item = document.querySelector(`#${element.id}`);
        if (item == null) { return; }
        item.classList.add("d-none");
    });
}

function MostrarElementosPagina(data) {
    data.forEach(element => {
        let item = document.querySelector(`#${element.id}`);
        if (item == null) {
            let containerItems = document.querySelector(`#${_idContainerItem}`);
            containerItems.insertAdjacentHTML('beforeend', `${element.Html}`);
        } else {
            item.classList.remove("d-none");
        }
    });
}

function CheckBtnBackNext() {
    //document.querySelector('#cf_pageActual').value = (paginaActual + 1);
    //document.querySelector('#cf_countPageTotal').innerHTML = (listPagina.length);
    let painas = document.querySelectorAll(`.${_classPaginas}`);
    painas.forEach(element => {
        let _pagina = element.dataset.pagina;
        if (_pagina == paginaActual) {
            element.classList.add("active");
        }
        else {
            element.classList.remove("active");
        }
    });

    document.querySelectorAll(`.${_idBtnPaginaAnterior}`).forEach(element => {
        if (paginaActual == 0) {
            element.classList.add("d-none");
        } else {
            element.classList.remove("d-none");
        }
    });

    document.querySelectorAll(`.${_idBtnPaginaSiguiente}`).forEach(element => {
        if (paginaActual == (listPagina.length - 1)) {
            element.classList.add("d-none");
        } else {
            element.classList.remove("d-none");
        }
    });
}

//#endregion

///

//#region Contador

function SetCount() {
    idsSpanCount.forEach(element => {
        CountElement(`${_nameCountItem}${element}`);
    });
}

function CountElement(id) {
    let element = document.querySelector(`#${id}`);
    let count = 0;

    listDisplayData.forEach(element => {
        if (element.AllFilter.find(x => x == (id.replace(_nameCountItem, ""))) != undefined) { count++; }
    });

    element.innerHTML = count;
}

// document.querySelector(".products-filter-title-button").addEventListener('click', function (event) {
//     SetCount();
// });

//#endregion

///

//#region search

const _search = document.querySelector(`#${_idSearch}`);
if (_search != null) {
    _search.addEventListener('change', function (event) {
        SearchElement(event.target.value);
    });
}

const _btnSearch = document.querySelector(`#${_idBtnSearch}`);
if (_btnSearch != null) {
    _btnSearch.addEventListener('click', function (event) {
        SearchElement(document.querySelector(`#${_idSearch}`).value);
    });
}

function SearchElement(value) {
    let _value = StrNormalize(value);
    let data = [];
    let dataSearch = [];

    if (listFiltersApplied.length == 0) {
        data = listItems.slice();
    } else {
        data = listDisplayData.slice();
    }

    if (_value == "") {
        dataSearch = data;
    }
    else {
        data.forEach(element => {
            let _Title = (StrNormalize(element.Title)).includes(_value);
            let _Bajada = (StrNormalize(element.Bajada)).includes(_value);

            let itemValid = _Title || _Bajada;
            if (itemValid) {
                dataSearch.push(element);
            }
        });
    }

    Order(dataSearch);
    Paginar();
}

//#endregion

///

//#region opciones para filtros (count hide)

function SetCount() {
    listIdSpanCount.forEach(element => {
        CountElement(`${_nameCountItem}${element}`);
    });
}

function CountElement(idCount) {
    let element = document.querySelector(`#${idCount}`);
    element.innerHTML = _Count(idCount);
}

function _Count(idCount) {
    let count = 0;
    listDisplayData.forEach(element => {
        if (element.AllFilter.find(x => x == (idCount.replace(_nameCountItem, ""))) != undefined) { count++; }
    });
    return count;
}

function _HideFilter(data) {
    data.forEach(element => {
        let value = element.UrlName;
        let idCount = `${_nameCountItem}${value}`;
        let count = _Count(idCount);

        let spaunIten = document.querySelector(`#${idCount}`);
        if (count == 0) {
            spaunIten.parentElement.parentElement.parentElement.classList.add("d-none");
        }
        else {
            spaunIten.parentElement.parentElement.parentElement.classList.remove("d-none");
        }
    });
}

//#endregion

///

function init() {
    GetListItem();
    if (listItems.length != 0) {
        Order(listItems);
        Paginar();
        SetCount();
    }
}

window.addEventListener("load", function (event) {
    //_isLoadind(false, "init");
});

///

function GetIndexForDelete(_array, itemDelete) {
    return _array.findIndex(x => x.UrlName == itemDelete);
}

function DeleteElementArray() {
    let _filtro = id.replace(_nameFilter, "");
    listFiltersApplied.splice(listFiltersApplied.indexOf(_filtro), 1);
}

//retorna el str en minuscula y sin asentos
function StrNormalize(str) {
    //.toUpperCase()
    return (str.trim().toLowerCase()).normalize("NFD").replace(/[\u0300-\u036f]/g, "");
}

</script>




