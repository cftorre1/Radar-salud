}.achs-accordion .accordion-item .accordion-button:focus, .achs-faq .achs-faq-item button:focus, .achs-tabs-h .achs-acordion .achs-acordion-item button:not(.collapsed) {
    box-shadow: unset;
}
.achs-tabs-h .achs-acordion .achs-acordion-item .accordion-body {
    padding: 0 1em 1em;
    font-size: 1.1rem;
    font-family: var(--primary-font);
    line-height: 28.8px;
}
.achs-tabs-h .achs-acordion .achs-acordion-item .accordion-body ul {
    padding: 0;
    list-style: none;
    margin-bottom: 0;
}
.achs-tabs-h .achs-acordion .achs-acordion-item .accordion-body ul li, .achs-tabs-h .achs-acordion .achs-acordion-item .accordion-body ul li p {
