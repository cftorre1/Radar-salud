<section class="mb-5 section">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h1 class="text-center">Salud y Bienestar</h1>
                <div class="col-lg-12 mt-4 d-flex align-items-center justify-content-center">
                    <p class="me-3 mb-0">Filtros rápidos:</p>

                    <ul class="cont-filters -salud mb-0">
                            <li>
                                <button id="btn_dermatolog&#237;a" onclick="BtnOnclick(this)" class="tag-border -salud cf_dermatolog&#237;a">Dermatolog&#237;a<i class="bi bi-x-circle-fill ms-2"></i></button>
                                <input id="filter_dermatolog&#237;a" type="checkbox" value="dermatolog&#237;a" class="d-none">
                            </li>
                            <li>
                                <button id="btn_salud-mental" onclick="BtnOnclick(this)" class="tag-border -salud cf_salud-mental">Salud Mental<i class="bi bi-x-circle-fill ms-2"></i></button>
                                <input id="filter_salud-mental" type="checkbox" value="salud-mental" class="d-none">
                            </li>
                            <li>
                                <button id="btn_medicina-general" onclick="BtnOnclick(this)" class="tag-border -salud cf_medicina-general">Medicina General<i class="bi bi-x-circle-fill ms-2"></i></button>
                                <input id="filter_medicina-general" type="checkbox" value="medicina-general" class="d-none">
                            </li>
                            <li>
                                <button id="btn_traumatologia" onclick="BtnOnclick(this)" class="tag-border -salud cf_traumatologia">Traumatolog&#237;a<i class="bi bi-x-circle-fill ms-2"></i></button>
                                <input id="filter_traumatologia" type="checkbox" value="traumatologia" class="d-none">
                            </li>

                        
                    </ul>
                    
                </div>
            </div>
            <div class="col-lg-12 mt-4">
                <div id="cf_listItem" class="row achs-cards">


                    <div class="col-lg-4 col-md-6 col-sm-12">
                        <div class="card achs-card card-news -salud">
                            <div class="card-img">
                            <img src="./assets/images/Achs-salud/red-1.png" data-src="./assets/images/Achs-salud/red-1.png" class="lazy entered loaded" alt="Encuentra la postura correcta para trabajar frente al computador" loading="lazy" data-ll-status="loaded">
                            </div>                            
                            <div class="card-body">
                            <h5>Encuentra la postura correcta para trabajar
                                frente al computador</h5>
                            <p class="card-text">Cuando nos encontramos en una oficina es muy común que nos
                                sentemos frente al computador con una mala postura…</p>
                            <span class="d-block mb-3"><strong>Escrito por:</strong> Francisca Matamala</span>
