    line-height: 25px;
    color: var(--white);
    transition: .3s;
}
.achs-tabs-h .achs-acordion .achs-acordion-item .accordion-button::after {
    background-image: unset;
    content: "\F4FE";
    font-family: bootstrap-icons!important;
    font-weight: 800!important;
    font-size: 25px;
    line-height: 25px;
    color: var(--primary-color);
