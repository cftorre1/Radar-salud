    display: flex;
    align-items: center;
    font-size: 1.1rem;
}
.achs-tabs-h .achs-acordion .achs-acordion-item .accordion-body ul li::before {
    content: "";
    display: block;
    width: 3px;
    height: 3px;
    background-color: var(--gray);
    border-radius: 100%;
    position: absolute;
    left: 10px;
}
.cont-filters, .list-stars {
    padding: unset;
    list-style: none;
}
.achs-pagination .page-number, .achs-pagination .page-numbers .arrow {
    font-family: AchsNuevaSansSemiBold;
    color: var(--primary-color);
    position: relative;
    width: 100%}
.achs-pagination {
    display: flex;
    justify-content: center;
    margin: 1em auto;
    max-width: max-content;
    width: 100%}
.achs-pagination .page-numbers {
    list-style: none;
    padding: .5rem;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--white);
    border-radius: 9999px;
    box-shadow: var(--shadow);
    width: 100%;
    min-height: 50px;
}
.pag-md {
    display: none!important;
}
.achs-pagination .page-number {
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: .5s;
    text-decoration: none;
    max-width: 50%;
    min-height: 50px;
    cursor: pointer;
    margin: 0 5px;
}
.achs-pagination .num a {
    font-size: 1em;
    font-family: var(--primary-font);
    color: var(--gray);
    padding: 0 5px;
    text-decoration: unset;
}
.achs-pagination .page-number:hover .arrow, .achs-pagination .page-numbers .page-number.active {
    background: var(--bg);
    color: var(--secondary-color);
    border-radius: 9999px;
    min-width: 50px;
}
.achs-pagination .page-numbers .arrow {
    height: 100%;
    background-color: transparent;
    font-size: 1.1rem;
    padding: 10px 20px;
    opacity: 1;
    border-radius: 99999px;
    top: 0;
    transform: unset;
    left: 0;
    right: 0;
    text-decoration: unset;
}
.achs-pagination .page-number.next .arrow, .achs-pagination .page-number.prev .arrow {
    text-decoration: underline;
    display: flex;
    justify-content: center;
    align-items: center;
    border: unset;
}
.achs-pagination .page-numbers .arrow i::before, .go-Up i::before {
    font-weight: 800!important;
}
.achs-pagination .page-number.next i {
    margin-left: 5px;
}
.achs-pagination .page-number.next:hover, .achs-pagination .page-number.prev:hover {
    color: var(--secondary-color);
    max-width: 100%}
.achs-pagination .page-number.nex.disabled, .achs-pagination .page-number.prev.disabled {
    color: var(--primary-color);
    opacity: .5;
    text-decoration: none;
}
.achs-pagination .page-number.prev.disabled:after {
    filter: grayscale(1);
}
.section-video iframe, .section-video img {
    max-width: 100%;
    width: 100%;
    border-radius: 16px;
}
.cont-filters {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
}
.cont-filters li {
    margin-right: 10px;
}
.cont-filters li:last-child {
    margin-right: unset;
}
.achs-maps.achs-cards .box-action .btn-achs.-border, .achs-maps.achs-cards .btn-achs.-border {
    float: unset;
}
.achs-maps.achs-cards .achs-card iframe {
    max-width: 100%;
    border-radius: 16px;
}
.achs-links-icons .achs-cards.-salud .achs-card {
    min-height: 120px;
}
.achs-links-icons .bg-circle {
    width: 56px;
    height: 56px;
    border-radius: 99999px;
    padding: 10px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}
.achs-links-icons .achs-cards.-salud .achs-card .-bg-light i {
    color: var(--gray-dark);
    font-size: 24px;
}
.achs-links-icons .achs-cards .achs-card {
    position: relative;
}
.achs-links-icons .achs-cards .achs-card a {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    text-indent: -999999px;
    overflow: hidden;
    z-index: 4;
}
.btn-go-Up {
    background-color: var(--secondary-dark);
    border-color: var(--secondary-dark);
    border: unset;
    border-radius: 99999px;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: fixed;
    z-index: 9;
    right: 15px;
    bottom: 5%}
.btn-go-Up i {
    color: var(--white);
    font-size: 20px;
}
.go-Up {
    color: var(--primary-color);
    font-size: 1.1rem;
    margin: 1rem 20px 2rem 0;
    font-family: AchsNuevaSansBold;
    position: relative;
    display: none;
    background-color: unset;
    border: none;
    width: 100%}
#modalRayos .modal-content .modal-body, .go-Up i {
    font-size: 18px;
}
.list-stars {
    display: flex;
    justify-content: center;
    align-items: center;
}
.achs-accordion {
    max-width: 880px;
    margin: 2em auto 1em;
}
.achs-accordion .accordion-button:not(.collapsed) {
    background-color: var(--white);
    border: unset;
    box-shadow: unset;
    padding: 0;
}
.accordion-button::after, .achs-accordion .accordion-button:not(.collapsed)::after {
    background-image: none;
}
.achs-accordion .accordion-item .accordion-button.collapsed {
    width: 100%;
    padding-top: 0;
    padding-left: 0;
}
.achs-accordion .accordion-item {
    border: unset;
    display: flex;
    flex-direction: column;
    align-items: baseline;
    position: relative;
    background-color: transparent;
}
.achs-accordion .box-btn {
    margin-top: 1em;
    display: flex;
    justify-content: flex-end;
    width: 100%}
.achs-accordion .accordion-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    width: 50px;
    height: 48px;
    border-radius: 99999px;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
}
.achs-accordion .accordion-item::after {
    content: "";
    width: 2px;
    height: 100%;
    display: block;
    position: absolute;
    top: 0;
    left: 22px;
}
.achs-accordion .accordion-item.disabled::after, .achs-accordion .accordion-item.disabled::before {
    background-color: var(--gray-line);
}
.achs-accordion .accordion-item:last-child::after {
