.achs-pagination .page-numbers .arrow, .achs-tabs-h .achs-acordion .achs-acordion-item .accordion-body ul li, .achs-tabs-h .achs-acordion .achs-acordion-item .accordion-body ul li p, .form-check, .section-search .cont-result .box-result .list-result li, .section-search .cont-result .box-result .list-result li a, .section-search .cont-result .box-result .list-result li p, .section-search .cont-result .box-result .list-result li span, .type-switch .btn-switch, label {
