cl\/wp-json\/wp\/v2\/tags?post=107145"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":106983,"date":"2026-09-03T17:54:32","date_gmt":"2026-09-03T20:54:32","guid":{"rendered":"https:\/\/ist.cl\/?p=106983"},"modified":"2026-09-03T17:54:36","modified_gmt":"2026-09-03T20:54:36","slug":"reconocimos-a-h-constructora-por-cumplir-un-ano-sin-accidentes","status":"publish","type":"post","link":"https:\/\/ist.cl\/reconocimos-a-h-constructora-por-cumplir-un-ano-sin-accidentes\/","title":{"rendered":"Reconocimos a h. Constructora por cumplir un a\u00f1o sin accidentes"},"content":{"rendered":"<div class=\"et_pb_section et_pb_section_7 et_section_regular\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_7\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_7  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_7  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p class=\"isSelectedEnd\">03\/09\/2026<\/p>\n<h1>Reconocimos a h. Constructora por cumplir un a\u00f1o sin accidentes<\/h1>\n<p><img decoding=\"async\" loading=\"lazy\" class=\"wp-image-106985 aligncenter size-large\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/WhatsApp-Image-2026-08-26-at-10.36.27-AM-2-1024x460.jpeg\" alt=\"\" width=\"1024\" height=\"460\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/WhatsApp-Image-2026-08-26-at-10.36.27-AM-2-980x441.jpeg 980w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/WhatsApp-Image-2026-08-26-at-10.36.27-AM-2-480x216.jpeg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) 1024px, 100vw\" \/><\/p>\n<p><span style=\"font-weight: 400;\">Reconocimos a h. Constructora tras completar un a\u00f1o sin accidentes, mediante la entrega de un galvano conmemorativo.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">El reconocimiento busca destacar el compromiso sostenido de la organizaci\u00f3n y de sus trabajadores con la prevenci\u00f3n de riesgos, promoviendo pr\u00e1cticas que contribuyen a generar espacios de trabajo m\u00e1s seguros, saludables y sostenibles.<\/span><\/p>\n<p><span style=\"font-weight: 400;\">Valoramos el compromiso demostrado por la constructora, destacando que alcanzar un a\u00f1o sin accidentes es resultado del trabajo permanente, la responsabilidad y la participaci\u00f3n de quienes forman parte de la organizaci\u00f3n.<\/span><\/p><\/div>\n\t\t\t<\/div><div class=\"et_pb_module et_pb_gallery et_pb_gallery_7  et_pb_bg_layout_light et_pb_gallery_grid\">\n\t\t\t\t<div class=\"et_pb_gallery_items et_post_gallery clearfix\" data-per_page=\"4\"><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_7_0\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/Constructora-H.jpeg\" title=\"Constructora H\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/Constructora-H-400x284.jpeg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/Constructora-H.jpeg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/Constructora-H-400x284.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-106986\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><\/div><div class=\"et_pb_gallery_pagination\"><\/div><\/div>\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n","protected":false},"excerpt":{"rendered":"<p>03\/09\/2026 Reconocimos a h. Constructora por cumplir un a\u00f1o sin accidentes Reconocimos a h. Constructora tras completar un a\u00f1o sin accidentes, mediante la entrega de un galvano conmemorativo. El reconocimiento busca destacar el compromiso sostenido de la organizaci\u00f3n y de sus trabajadores con la prevenci\u00f3n de riesgos, promoviendo pr\u00e1cticas que contribuyen a generar espacios de [&hellip;]<\/p>\n","protected":false},"author":32,"featured_media":106986,"comment_status":"closed","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_et_pb_use_builder":"on","_et_pb_old_content":"","_et_gb_content_width":""},"categories":[14,12,1],"tags":[],"acf":[],"jetpack_featured_media_url":"https:\/\/ist.cl\/wp-content\/uploads\/2026\/09\/Constructora-H.jpeg","jetpack_sharing_enabled":true,"_links":{"self":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106983"}],"collection":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/users\/32"}],"replies":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/comments?post=106983"}],"version-history":[{"count":3,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106983\/revisions"}],"predecessor-version":[{"id":106989,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106983\/revisions\/106989"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media\/106986"}],"wp:attachment":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media?parent=106983"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/categories?post=106983"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/tags?post=106983"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":106744,"date":"2026-08-31T13:43:55","date_gmt":"2026-08-31T16:43:55","guid":{"rendered":"https:\/\/ist.cl\/?p=106744"},"modified":"2026-08-31T13:43:59","modified_gmt":"2026-08-31T16:43:59","slug":"felicitamos-al-comite-paritario-de-transportes-cruz-del-sur-temuco-por-certificacion-sac","status":"publish","type":"post","link":"https:\/\/ist.cl\/felicitamos-al-comite-paritario-de-transportes-cruz-del-sur-temuco-por-certificacion-sac\/","title":{"rendered":"Felicitamos al Comit\u00e9 Paritario de Transportes Cruz del Sur Temuco por certificaci\u00f3n SAC"},"content":{"rendered":"<div class=\"et_pb_section et_pb_section_8 et_section_regular\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_8\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_8  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_8  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p class=\"isSelectedEnd\">31\/08\/2026<\/p>\n<h1>Felicitamos al Comit\u00e9 Paritario de Transportes Cruz del Sur Temuco por certificaci\u00f3n SAC<\/h1>\n<p><img decoding=\"async\" loading=\"lazy\" class=\"wp-image-106748 aligncenter size-large\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur-1024x451.jpg\" alt=\"\" width=\"1024\" height=\"451\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur-1024x451.jpg 1024w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur-980x432.jpg 980w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur-480x212.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) 1024px, 100vw\" \/><\/p>\n<p>Con orgullo destacamos el compromiso del Comit\u00e9 Paritario de Higiene y Seguridad de la sucursal Temuco de Transportes Cruz del Sur Ltda., que recibi\u00f3 la certificaci\u00f3n del Sistema de Acreditaci\u00f3n de Comit\u00e9s (SAC).<\/p>\n<p>Este reconocimiento pone en valor el trabajo permanente que desarrolla el comit\u00e9 para fortalecer la seguridad y salud de las y los trabajadores, promoviendo espacios de participaci\u00f3n y colaboraci\u00f3n que contribuyen a una gesti\u00f3n preventiva m\u00e1s s\u00f3lida.<\/p>\n<p>La certificaci\u00f3n representa el resultado de un esfuerzo constante y colaborativo, que adquiere especial relevancia frente a los desaf\u00edos que plantea el Decreto Supremo N\u00b044, impulsando una participaci\u00f3n m\u00e1s activa de las personas y organizaciones en la gesti\u00f3n de los riesgos laborales.<\/p>\n<p>Valoramos especialmente el compromiso de quienes integran este comit\u00e9 paritario y las distintas iniciativas que impulsan para seguir avanzando en una cultura preventiva cercana, participativa y comprometida con el cuidado de la vida.<\/p>\n<p>Porque prevenir tambi\u00e9n es escuchar, participar y trabajar juntos para construir espacios laborales cada vez m\u00e1s seguros, saludables y sostenibles. <\/p><\/div>\n\t\t\t<\/div><div class=\"et_pb_module et_pb_gallery et_pb_gallery_8  et_pb_bg_layout_light et_pb_gallery_grid\">\n\t\t\t\t<div class=\"et_pb_gallery_items et_post_gallery clearfix\" data-per_page=\"4\"><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_8_0\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur.jpg\" title=\"Transportes Cruz del Sur\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-106748\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><\/div><div class=\"et_pb_gallery_pagination\"><\/div><\/div>\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n","protected":false},"excerpt":{"rendered":"<p>31\/08\/2026 Felicitamos al Comit\u00e9 Paritario de Transportes Cruz del Sur Temuco por certificaci\u00f3n SAC Con orgullo destacamos el compromiso del Comit\u00e9 Paritario de Higiene y Seguridad de la sucursal Temuco de Transportes Cruz del Sur Ltda., que recibi\u00f3 la certificaci\u00f3n del Sistema de Acreditaci\u00f3n de Comit\u00e9s (SAC). Este reconocimiento pone en valor el trabajo permanente [&hellip;]<\/p>\n","protected":false},"author":32,"featured_media":106748,"comment_status":"closed","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_et_pb_use_builder":"on","_et_pb_old_content":"","_et_gb_content_width":""},"categories":[14,12,1],"tags":[],"acf":[],"jetpack_featured_media_url":"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Transportes-Cruz-del-Sur.jpg","jetpack_sharing_enabled":true,"_links":{"self":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106744"}],"collection":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/users\/32"}],"replies":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/comments?post=106744"}],"version-history":[{"count":3,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106744\/revisions"}],"predecessor-version":[{"id":106753,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106744\/revisions\/106753"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media\/106748"}],"wp:attachment":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media?parent=106744"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/categories?post=106744"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/tags?post=106744"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":106472,"date":"2026-08-25T15:29:50","date_gmt":"2026-08-25T18:29:50","guid":{"rendered":"https:\/\/ist.cl\/?p=106472"},"modified":"2026-08-25T15:29:54","modified_gmt":"2026-08-25T18:29:54","slug":"reconocimos-a-fl-ingenieria-por-26-anos-de-trayectoria-y-compromiso","status":"publish","type":"post","link":"https:\/\/ist.cl\/reconocimos-a-fl-ingenieria-por-26-anos-de-trayectoria-y-compromiso\/","title":{"rendered":"Reconocimos a F&#038;L Ingenier\u00eda por 26 a\u00f1os de trayectoria y compromiso"},"content":{"rendered":"<div class=\"et_pb_section et_pb_section_9 et_section_regular\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_9\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_9  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_9  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p class=\"isSelectedEnd\">25\/08\/2026<\/p>\n<h1>Reconocimos a F&amp;L Ingenier\u00eda por 26 a\u00f1os de trayectoria y compromiso<\/h1>\n<p><img decoding=\"async\" loading=\"lazy\" class=\"wp-image-106474 aligncenter size-large\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-1024x696.jpg\" alt=\"\" width=\"1024\" height=\"696\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-1024x696.jpg 1024w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-980x666.jpg 980w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-480x326.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) 1024px, 100vw\" \/><\/p>\n<p>Con gran orgullo reconocimos a F&amp;L Ingenier\u00eda por sus m\u00e1s de 26 a\u00f1os de trayectoria y compromiso, destacando especialmente su permanente dedicaci\u00f3n a la seguridad y el cuidado de la vida.<\/p>\n<p>En ese sentido, la compa\u00f1\u00eda ha mantenido un destacado historial sin accidentes, logro que refleja no solo su experiencia y profesionalismo, sino tambi\u00e9n una s\u00f3lida cultura de trabajo basada en la prevenci\u00f3n y el compromiso.<\/p>\n<p>Este reconocimiento pone en valor una trayectoria construida con responsabilidad y dedicaci\u00f3n, donde la seguridad ha sido un eje fundamental del quehacer de F&amp;L Ingenier\u00eda.<\/p>\n<p>La compa\u00f1\u00eda destac\u00f3 que este hito es resultado del trabajo constante de sus equipos y de una cultura que entiende la seguridad como una responsabilidad compartida y presente en cada tarea. Con este reconocimiento, seguimos avanzando poniendo en todo momento a las personas en el centro.<\/p><\/div>\n\t\t\t<\/div><div class=\"et_pb_module et_pb_gallery et_pb_gallery_9  et_pb_bg_layout_light et_pb_gallery_grid\">\n\t\t\t\t<div class=\"et_pb_gallery_items et_post_gallery clearfix\" data-per_page=\"4\"><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_9_0\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-1.jpg\" title=\"El reconocimiento\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-1-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-1.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-1-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-106475\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_9_1\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Reconocimiento.jpeg\" title=\"Reconocimiento\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Reconocimiento-400x284.jpeg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Reconocimiento.jpeg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Reconocimiento-400x284.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-106476\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><\/div><div class=\"et_pb_gallery_pagination\"><\/div><\/div>\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n","protected":false},"excerpt":{"rendered":"<p>25\/08\/2026 Reconocimos a F&amp;L Ingenier\u00eda por 26 a\u00f1os de trayectoria y compromiso Con gran orgullo reconocimos a F&amp;L Ingenier\u00eda por sus m\u00e1s de 26 a\u00f1os de trayectoria y compromiso, destacando especialmente su permanente dedicaci\u00f3n a la seguridad y el cuidado de la vida. En ese sentido, la compa\u00f1\u00eda ha mantenido un destacado historial sin accidentes, [&hellip;]<\/p>\n","protected":false},"author":32,"featured_media":106475,"comment_status":"closed","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_et_pb_use_builder":"on","_et_pb_old_content":"","_et_gb_content_width":""},"categories":[14,12,1],"tags":[],"acf":[],"jetpack_featured_media_url":"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/El-reconocimiento-1.jpg","jetpack_sharing_enabled":true,"_links":{"self":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106472"}],"collection":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/users\/32"}],"replies":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/comments?post=106472"}],"version-history":[{"count":3,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106472\/revisions"}],"predecessor-version":[{"id":106479,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/106472\/revisions\/106479"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media\/106475"}],"wp:attachment":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media?parent=106472"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/categories?post=106472"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/tags?post=106472"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":106258,"date":"2026-08-19T19:20:08","date_gmt":"2026-08-19T22:20:08","guid":{"rendered":"https:\/\/ist.cl\/?p=106258"},"modified":"2026-08-19T19:22:18","modified_gmt":"2026-08-19T22:22:18","slug":"poniendo-a-las-personas-en-el-centro-en-el-seminario-la-hospitalidad-que-viene-sociedad-5-0-humanizacion-y-cuidado-de-la-vida","status":"publish","type":"post","link":"https:\/\/ist.cl\/poniendo-a-las-personas-en-el-centro-en-el-seminario-la-hospitalidad-que-viene-sociedad-5-0-humanizacion-y-cuidado-de-la-vida\/","title":{"rendered":"Poniendo a las personas en el centro en seminario \u201cLa hospitalidad que viene: Sociedad 5.0, humanizaci\u00f3n y cuidado de la vida\u201d"},"content":{"rendered":"<div class=\"et_pb_section et_pb_section_10 et_section_regular\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_10\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_10  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_10  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p class=\"isSelectedEnd\">19\/08\/2026<\/p>\n<h1>Poniendo a las personas en el centro en seminario \u201cLa hospitalidad que viene: Sociedad 5.0, humanizaci\u00f3n y cuidado de la vida\u201d<\/h1>\n<p><img decoding=\"async\" loading=\"lazy\" class=\"wp-image-106272 aligncenter size-large\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Mesa-de-conversacion-1024x576.jpg\" alt=\"\" width=\"1024\" height=\"576\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Mesa-de-conversacion-980x552.jpg 980w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Mesa-de-conversacion-480x270.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) 1024px, 100vw\" \/><\/p>\n<p>Junto al Hospital Militar de Santiago (HMS) realizamos el seminario \u201cLa hospitalidad que viene: Sociedad 5.0, humanizaci\u00f3n y cuidado de la vida\u201c.<\/p>\n<p>La jornada convoc\u00f3 a representantes civiles, militares y profesionales de la salud para reflexionar sobre la importancia de comprender los desaf\u00edos del mundo actual con foco en inteligencia artificial, tecnolog\u00eda y neurociencia.<\/p>\n<p>El encuentro comenz\u00f3 con una ponencia magistral de Jorge Sanhueza, vicerrector del Medio de la Universidad Adolfo Ib\u00e1\u00f1ez, quien se refiri\u00f3 a la sociedad actual e incorporaci\u00f3n de la inteligencia artificial en la vida cotidiana de las personas, para posteriormente dar paso a una mesa de conversaci\u00f3n moderada por IST en la que participaron el director del HMS, Luis C\u00e1mpora, y los m\u00e9dicos Gonzalo Far\u00edas e Ignacio P\u00e9rez.<\/p>\n<p>\u201cQuiero agradecer al departamento de Prevenci\u00f3n de Riesgos del HMS y el IST por este gran seminario en el que participamos, una instancia en la que todos nuestros colaboradores pueden pensar en lo que hoy est\u00e1 en pauta que es la forma en que la tecnolog\u00eda y la inteligencia artificial puede hacer nuestro trabajo m\u00e1s productivo y eficiente, adem\u00e1s de entregar un mensaje claro de que podemos seguir siendo m\u00e1s humanos y c\u00e1lidos en nuestro espacio de trabajo\u201d, coment\u00f3 Luis C\u00e1mpora, director del HMS.<\/p>\n<p>Por su parte, el doctor Ignacio P\u00e9rez dijo que \u201cla tecnolog\u00eda lo que busca es resolver problemas concretos. En el hospital nos aseguramos muy bien de cual es la necesidad que estamos tratando de resolver para luego hablar con las partes involucradas y ver oportunidades de mejora, siempre con especial atenci\u00f3n en nuestros pacientes\u201d.<\/p>\n<p>El doctor Gonzalo Far\u00edas concluy\u00f3 que \u201ces s\u00faper importante tener estas instancias de conversaci\u00f3n para hablar sobre el impacto de las nuevas tecnolog\u00edas y la manera en que se relacionan con la atenci\u00f3n de pacientes y los riesgos, la forma en que se puede humanizar y adaptar a los cambios tecnol\u00f3gicos. Estas reuniones son muy interesantes por el foco que se le puede dar desde el punto de vista del IST como instituci\u00f3n\u201d.<\/p>\n<p>Este encuentro reafirma el compromiso del IST y HMS con el bienestar integral y la promoci\u00f3n de espacios donde el cuidado est\u00e9 siempre en el centro.<\/p><\/div>\n\t\t\t<\/div><div class=\"et_pb_module et_pb_gallery et_pb_gallery_10  et_pb_bg_layout_light et_pb_gallery_grid\">\n\t\t\t\t<div class=\"et_pb_gallery_items et_post_gallery clearfix\" data-per_page=\"4\"><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_10_0\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Foto-grupal..jpg\" title=\"Foto grupal.\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Foto-grupal.-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Foto-grupal..jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Foto-grupal.-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-106273\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_10_1\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Cierre-del-seminario.jpg\" title=\"Cierre del seminario\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Cierre-del-seminario-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Cierre-del-seminario.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Cierre-del-seminario-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-106274\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_10_2\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Doctor-Ignacio-Perez.jpg\" title=\"Doctor Ignacio P\u00e9rez\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Doctor-Ignacio-Perez-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Doctor-Ignacio-Perez.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Doctor-Ignacio-Perez-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-106275\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_10_3\">\n\t\t\t\t<div class='et_pb_g