ory","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/categories?post=105307"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/tags?post=105307"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":105186,"date":"2026-08-12T11:38:53","date_gmt":"2026-08-12T14:38:53","guid":{"rendered":"https:\/\/ist.cl\/?p=105186"},"modified":"2026-08-12T11:38:58","modified_gmt":"2026-08-12T14:38:58","slug":"realizamos-una-exitosa-jornada-preventiva-en-tps","status":"publish","type":"post","link":"https:\/\/ist.cl\/realizamos-una-exitosa-jornada-preventiva-en-tps\/","title":{"rendered":"\u00a1Realizamos una exitosa jornada preventiva en TPS!"},"content":{"rendered":"<div class=\"et_pb_section et_pb_section_15 et_section_regular\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_15\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_15  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_15  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p class=\"isSelectedEnd\">10\/08\/2026<\/p>\n<h1>\u00a1Realizamos una exitosa jornada preventiva en TPS!<\/h1>\n<p><img decoding=\"async\" loading=\"lazy\" class=\"wp-image-105289 aligncenter size-large\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-1024x591.jpg\" alt=\"\" width=\"1024\" height=\"591\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-1024x591.jpg 1024w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-980x566.jpg 980w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-480x277.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) 1024px, 100vw\" \/><\/p>\n<p>Junto al Comit\u00e9 Paritario de Muellaje (CPHS) desarrollamos una exitosa campa\u00f1a de prevenci\u00f3n de accidentes de trayecto, orientada a reforzar conductas seguras y entregar herramientas pr\u00e1cticas para que cada persona pueda llegar y regresar a casa de manera segura.<\/p>\n<p>Durante la jornada se abordaron distintos factores de riesgo asociados a la conducci\u00f3n, destacando especialmente los peligros de utilizar el celular mientras se conduce. Esta conducta puede multiplicar por cuatro el riesgo de sufrir un accidente. Asimismo, se reforz\u00f3 que, a una velocidad de 80 km\/h, apartar la mirada de la ruta durante solo dos segundos implica avanzar aproximadamente 44 metros sin prestar atenci\u00f3n al camino.<\/p>\n<p>Otro de los mensajes centrales de la campa\u00f1a fue la importancia de utilizar correctamente el cintur\u00f3n de seguridad en todos los asientos del veh\u00edculo, incluso durante trayectos cortos.<\/p>\n<p>Junto con ello, se enfatiz\u00f3 la necesidad de mantener los veh\u00edculos en buenas condiciones, realizando revisiones peri\u00f3dicas y prestando especial atenci\u00f3n a elementos esenciales para una conducci\u00f3n segura, como luces, frenos y neum\u00e1ticos.<\/p>\n<p>Este tipo de iniciativas reflejan la importancia del trabajo conjunto para fortalecer la prevenci\u00f3n y el cuidado de la vida.<\/p><\/div>\n\t\t\t<\/div><div class=\"et_pb_module et_pb_gallery et_pb_gallery_15  et_pb_bg_layout_light et_pb_gallery_grid\">\n\t\t\t\t<div class=\"et_pb_gallery_items et_post_gallery clearfix\" data-per_page=\"4\"><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_15_0\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-1.jpg\" title=\"Actividad de seguridad\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-1-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-1.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Actividad-de-seguridad-1-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-105291\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_15_1\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Equipo.jpeg\" title=\"Equipo\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Equipo-400x284.jpeg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Equipo.jpeg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Equipo-400x284.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-105292\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_15_2\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Encuentro-sobre-prevencion-en-TPS.jpeg\" title=\"Encuentro sobre prevenci\u00f3n en TPS\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Encuentro-sobre-prevencion-en-TPS-400x284.jpeg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Encuentro-sobre-prevencion-en-TPS.jpeg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Encuentro-sobre-prevencion-en-TPS-400x284.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-105293\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_15_3\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Material-de-seguridad.jpeg\" title=\"Material de seguridad\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Material-de-seguridad-400x284.jpeg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Material-de-seguridad.jpeg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Material-de-seguridad-400x284.jpeg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-105294\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><\/div><div class=\"et_pb_gallery_pagination\"><\/div><\/div>\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n\t\t\t\t\n\t\t\t\t\n\t\t\t<\/div>\n","protected":false},"excerpt":{"rendered":"<p>10\/08\/2026 \u00a1Realizamos una exitosa jornada preventiva en TPS! Junto al Comit\u00e9 Paritario de Muellaje (CPHS) desarrollamos una exitosa campa\u00f1a de prevenci\u00f3n de accidentes de trayecto, orientada a reforzar conductas seguras y entregar herramientas pr\u00e1cticas para que cada persona pueda llegar y regresar a casa de manera segura. Durante la jornada se abordaron distintos factores de [&hellip;]<\/p>\n","protected":false},"author":32,"featured_media":105292,"comment_status":"closed","ping_status":"open","sticky":false,"template":"","format":"standard","meta":{"_et_pb_use_builder":"on","_et_pb_old_content":"","_et_gb_content_width":""},"categories":[14,12,1],"tags":[],"acf":[],"jetpack_featured_media_url":"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Equipo.jpeg","jetpack_sharing_enabled":true,"_links":{"self":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/105186"}],"collection":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts"}],"about":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/types\/post"}],"author":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/users\/32"}],"replies":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/comments?post=105186"}],"version-history":[{"count":4,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/105186\/revisions"}],"predecessor-version":[{"id":105295,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/posts\/105186\/revisions\/105295"}],"wp:featuredmedia":[{"embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media\/105292"}],"wp:attachment":[{"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/media?parent=105186"}],"wp:term":[{"taxonomy":"category","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/categories?post=105186"},{"taxonomy":"post_tag","embeddable":true,"href":"https:\/\/ist.cl\/wp-json\/wp\/v2\/tags?post=105186"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}},{"id":105042,"date":"2026-08-03T18:01:53","date_gmt":"2026-08-03T21:01:53","guid":{"rendered":"https:\/\/ist.cl\/?p=105042"},"modified":"2026-08-03T18:10:46","modified_gmt":"2026-08-03T21:10:46","slug":"con-gran-exito-participamos-en-congreso-latinoamericano-de-coaching-icf-chile-2026","status":"publish","type":"post","link":"https:\/\/ist.cl\/con-gran-exito-participamos-en-congreso-latinoamericano-de-coaching-icf-chile-2026\/","title":{"rendered":"Con gran \u00e9xito participamos en Congreso Latinoamericano de Coaching ICF Chile 2026"},"content":{"rendered":"<div class=\"et_pb_section et_pb_section_16 et_section_regular\" >\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_row et_pb_row_16\">\n\t\t\t\t<div class=\"et_pb_column et_pb_column_4_4 et_pb_column_16  et_pb_css_mix_blend_mode_passthrough et-last-child\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_module et_pb_text et_pb_text_16  et_pb_text_align_left et_pb_bg_layout_light\">\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t<div class=\"et_pb_text_inner\"><p class=\"isSelectedEnd\">03\/08\/2026<\/p>\n<h1>Con gran \u00e9xito participamos en Congreso Latinoamericano de Coaching ICF Chile 2026<\/h1>\n<p><img decoding=\"async\" loading=\"lazy\" class=\"wp-image-105056 aligncenter size-large\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro-1024x576.jpg\" alt=\"\" width=\"1024\" height=\"576\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro-1024x576.jpg 1024w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro-980x552.jpg 980w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro-480x270.jpg 480w\" sizes=\"(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) and (max-width: 980px) 980px, (min-width: 981px) 1024px, 100vw\" \/><\/p>\n<p>Con gran \u00e9xito participamos en el Congreso Latinoamericano de Coaching ICF Chile 2026, realizado el 31 de julio y 1 de agosto en la Universidad T\u00e9cnica Federico Santa Mar\u00eda, Sede San Joaqu\u00edn, en Santiago.<\/p>\n<p>El encuentro, organizado por ICF Chile, reuni\u00f3 a destacados speakers nacionales e internacionales y convoc\u00f3 a l\u00edderes, ejecutivos, coaches y profesionales de distintos sectores para reflexionar sobre los desaf\u00edos que enfrentan las organizaciones en un contexto de cambio acelerado, donde se trataron temas relacionados a conocimientos sobre liderazgo, bienestar organizacional y gesti\u00f3n del cambio, contribuyendo al intercambio de buenas pr\u00e1cticas y al fortalecimiento de capacidades para enfrentar los desaf\u00edos del entorno laboral.<\/p>\n<p>\u201cPoder entrar en conversaciones, reflexiones o exploraciones sobre los distintos temas es algo central. Uno puede tener una mirada, una perspectiva y esto hace que el camino siempre se est\u00e9 abriendo. El coaching es un camino que siempre est\u00e1 abierto y abraza m\u00e1s las preguntas que las respuestas, y est\u00e1 siempre invitando a la reflexi\u00f3n desde el coraz\u00f3n\u201d, dijo Julio Olalla, presidente de Newfield Network y pionero mundial del coaching ontol\u00f3gico.<\/p>\n<p>En ese sentido, Tania Labb\u00e9, gerenta de Cuidado y Desarrollo de IST, coment\u00f3 que \u201csiempre estos espacios son nutritivos y el coaching tiene algo que es muy afectivo, cari\u00f1oso, entonces volver a encontrarnos con mucha gente que fue parte de nuestro camino e inspiraci\u00f3n es muy bueno, y me toc\u00f3 un panel muy interesante. Me gusta que miremos con mayor profundidad todo lo que podemos hacer desde las organizaciones\u201c.<\/p>\n<p>Con esta participaci\u00f3n, continuamos fortaleciendo alianzas e iniciativas que promueven el desarrollo del talento, la excelencia organizacional y la construcci\u00f3n de entornos laborales preparados para los desaf\u00edos del futuro.<\/p><\/div>\n\t\t\t<\/div><div class=\"et_pb_module et_pb_gallery et_pb_gallery_16  et_pb_bg_layout_light et_pb_gallery_grid\">\n\t\t\t\t<div class=\"et_pb_gallery_items et_post_gallery clearfix\" data-per_page=\"4\"><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_16_0\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro.jpg\" title=\"Julio Olalla durante el encuentro\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-durante-el-encuentro-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-105056\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_16_1\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla.jpg\" title=\"Julio Olalla\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Julio-Olalla-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-105055\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_16_2\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Tania-Labbe-durante-el-panel-de-expertos.jpg\" title=\"Tania Labb\u00e9 durante el panel de expertos\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Tania-Labbe-durante-el-panel-de-expertos-400x284.jpg\" srcset=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Tania-Labbe-durante-el-panel-de-expertos.jpg 479w, https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Tania-Labbe-durante-el-panel-de-expertos-400x284.jpg 480w\" sizes=\"(max-width:479px) 479px, 100vw\" class=\"wp-image-105054\" \/>\n\t\t\t\t\t<span class=\"et_overlay\"><\/span>\n\t\t\t\t<\/a>\n\t\t\t\t<\/div><\/div><div class=\"et_pb_gallery_item et_pb_grid_item et_pb_bg_layout_light et_pb_gallery_item_16_3\">\n\t\t\t\t<div class='et_pb_gallery_image landscape'>\n\t\t\t\t\t<a href=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/Tania-Labbe-de-IST.jpg\" title=\"Tania Labb\u00e9 de IST\">\n\t\t\t\t\t<img decoding=\"async\" loading=\"lazy\" width=\"400\" height=\"284\" src=\"https:\/\/ist.cl\/wp-content\/uploads\/2026\/08\/