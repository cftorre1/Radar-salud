function redirect (redirect){
var urlEmpresa = "/portal/publico/empresa/home/";
var urlTrabajador = "/portal/publico/trabajador/home/";
var urlUnete = "/portal/publico/mutual/adhesion/";
var urlEntrar = "/portal/publico/empresa/home/";



if (redirect=="empresa"){
        window.location.href = urlEmpresa;
}
if (redirect=="trabajador"){
        window.location.href = urlTrabajador;
}
if (redirect=="unete"){
        window.location.href = urlUnete;
}
if (redirect=="entrar"){
        window.location.href = urlEntrar;
}
};
function setColor (color){
  jQuery('#franja-color').css('background-color', color);	
 }
</script>
