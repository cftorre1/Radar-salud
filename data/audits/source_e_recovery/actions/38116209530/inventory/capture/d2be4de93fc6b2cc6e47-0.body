<script>
jQuery(function ($) {

    // Ocultar los contenidos de los modales al cargar la página.
    $('body:not(.et-fb-root-ancestor) [class*="lightbox-content-"]')
        .addClass('mfp-hide');

    // Buscar todos los botones que abren modales.
    $('[class*="lightbox-trigger-"]').each(function () {

        const classes = this.className || '';
        const match = classes.match(
            /(?:^|\s)lightbox-trigger-([a-zA-Z0-9_-]+)(?:\s|$)/
        );

        if (!match) {
            return;
        }

        const modalId = match[1];
        const modalSelector = '.lightbox-content-' + modalId;

        $(this).magnificPopup({
            items: {
                src: modalSelector,
                type: 'inline'
            },
            mainClass: 'divi-form-modal',
            closeBtnInside: true,
            showCloseBtn: true,
            removalDelay: 200,
            overflowY: 'auto',

            callbacks: {
                open: function () {
                    $('body').addClass('divi-modal-open');
                    $('.mfp-wrap').attr('id', 'et-boc');
                },
                close: function () {
                    $('body').removeClass('divi-modal-open');
                }
            }
        });
    });

});
