<script type="text/javascript" >
			jquerync(document).ready(function(){
				jquerync('.text_rut').blur(function(ev) {	
					var pattern = /[^0-9\-kK]/g;		
					var num = this.value.replace(pattern, '');	
					try{
						if(num.length > 1){
							if(num.split("-").length == 1){
								var newNum = num.substring(0, num.length - 1) + "-" + num.substring(num.length - 1, num.length);
								num = newNum;
							}
						}
					} catch(exx){
						;
					}
					this.value = num.toUpperCase();
				});
			});
		</script>


<!-- 2022.03.10 -->
<script>

	const audioAyudaAudioChunks = [];
	var audioAyudaRecorder;
	var audioAyuda;
	var persisosAudio = false;
	var urlAudio = '';
	var estadoAudioDetenido = true;
	
	const recordAudio = () => {
		  return new Promise(resolve => {
			navigator.mediaDevices.getUserMedia({ audio: true })
			  .then(stream => {
				const mediaRecorder = new MediaRecorder(stream);

				mediaRecorder.addEventListener("dataavailable", event => {
				  audioAyudaAudioChunks.push(event.data);
				});

				const start = () => {
				  mediaRecorder.start();
				};

				const stop = () => {
				  return new Promise(resolve => {
					mediaRecorder.addEventListener("stop", () => {
					  const audioBlob = new Blob(audioAyudaAudioChunks);
					  const audioUrl = URL.createObjectURL(audioBlob);
					  const audioAyuda = new Audio(audioUrl);					  
					  const play = () => audioAyuda.play();
					  const pause = () => audioAyuda.pause();
					  const currentTime = () => audioAyuda.currentTime();
					  const duration = () => audioAyuda.duration();
					  resolve({ audioBlob, audioUrl, play, pause, currentTime, duration });
					});

					mediaRecorder.stop();
				  });
				};

				resolve({ start, stop });
			  });
		  });
		};
		
				
	function asignarPermisos(){
		console.log('asignarPermisos');	
		
		navigator.permissions.query({name: 'microphone'})
		.then((permission) => {
			console.log("microphone state", permission.state);	
			if(jquerync.trim(permission.state) == 'denied'){
				persisosAudio = false;
			} else if(jquerync.trim(permission.state) == 'prompt') {
				navigator.mediaDevices.getUserMedia({ audio: true });
				persisosAudio = false;
			} else {
				persisosAudio = true;
			}		
		}).catch((error) => {
			console.log('Got error :', error);
			persisosAudio = false;
		});
		
		return persisosAudio;
		
	}
	
	function verificarPermisos(){
		return persisosAudio;
	}
	
	function sleep(milliseconds) {
	  return new Promise((resolve) => {
	    setTimeout(resolve, milliseconds);
	  });
	}

	async function pausa() {
	  await sleep(1000);
	}

	
	function iniciarGrabacion(){
		console.log('iniciarGrabacion');
		estadoAudioDetenido = false;	
		(async () => {
		  audioAyudaRecorder = await recordAudio();
		  audioAyudaRecorder.start();		  
		})();
		
	}
	
	function detenerGrabacion(){
		if(!estadoAudioDetenido){		
			console.log('detenerGrabacion');
			try{	
				(async () => {
				  audioAyuda = await audioAyudaRecorder.stop();
				  estadoAudioDetenido = true;
				})();
			} catch(ex){
				;
			}
		}		
	}
	
	function eliminarGrabacion(){
		console.log('eliminarGrabacion');	
		if(!estadoAudioDetenido){	
			detenerGrabacion();
		}
		try{
			audioAyudaAudioChunks.splice(0,audioAyudaAudioChunks.length);
		} catch(ex){;}
		estadoAudioDetenido = true;
		
	}
	
	function reproducirAudio(){
		console.log('reproducirGrabacion');	
    	audioAyuda.play();
	}
	
	function detenerAudio(){
		console.log('detenerAudio');	
    	audioAyuda.pause();
    	audioBlob = new Blob(audioAyudaAudioChunks);
		audioUrl = URL.createObjectURL(audioBlob);
		audioAyuda = new Audio(audioUrl);
	}
	
	function recuperarGrabacion(){
		console.log('recuperarGrabacion');
		console.log(audioAyudaAudioChunks);
		return audioAyudaAudioChunks;
	}
	
	function guardaArchivo(){
	
		var id = new Date().getTime();
		var blobarchivo = recuperarGrabacion();
		var href = URL.createObjectURL(new Blob(blobarchivo));
		
		jquerync.ajax({
		   url:href,
		   type:'GET',
		    beforeSend: function (xhr) {
			    xhr.overrideMimeType('text/plain; charset=x-user-defined');
			  },
		   success: function (result, textStatus, jqXHR) {       
		      var binary = "";
			    var responseText = jqXHR.responseText;
			    var responseTextLen = responseText.length;			
			    for ( i = 0; i < responseTextLen; i++ ) {
			        binary += String.fromCharCode(responseText.charCodeAt(i) & 255)
			    }
			    var file = dataURLtoFile('data:audio/ogg;base64,'+btoa(binary),'test.ogg');
               
                var audioBase64 = btoa(binary);
              
		            jquerync.ajax({
					    type:'POST', 
					    url:'/MTWAS_SubeArchivosForms/rest/servicio', 
					    dataType: "text",
					    data:JSON.stringify({
    							"id": id,
					    		"archivo":audioBase64
					    	}), 
					     success:function(datos){
						    console.log('success ' + datos);
					    	urlAudio = datos;						    					        
					     }
					});					
		   }
		});		
	}
	
	function geturlAudio(){
		return urlAudio;	
	}
	
	function dataURLtoFile(dataurl, filename) {
 
        var arr = dataurl.split(','),
            mime = arr[0].match(/:(.*?);/)[1],
            bstr = atob(arr[1]), 
            n = bstr.length, 
            u8arr = new Uint8Array(n);
            
        while(n--){
            u8arr[n] = bstr.charCodeAt(n);
        }
        
        return new File([u8arr], filename, {type:mime});
    }


</script>

