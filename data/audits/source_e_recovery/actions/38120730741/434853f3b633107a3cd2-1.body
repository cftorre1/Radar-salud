<body id="content" class="lotusui30dojo tundra locale_es">	
	<!-- Google Tag Manager (noscript) -->
	<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5SVM4TR" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
	<!-- End Google Tag Manager (noscript) -->	
	


<input id="nombreUsuarioDyna" type="text" style="display: none;"
	value="0"></input>
<input id="apellidoPaternoDyna" type="text" style="display: none;"
	value="0"></input>
<input id="apellidoMaternoDyna" type="text" style="display: none;"
	value="0"></input>

<input id="rutEmpresaDyna" type="text" style="display: none;"
	value="-"></input>
<input id="rutEmpresaFormateadoDyna" type="text" style="display: none;"
	value="-"></input>
<input id="nroContratoDyna" type="text" style="display: none;"
	value="-"></input>
<input id="rutUsuarioDyna" type="text" style="display: none;"
	value="0"></input>
<input id="rutUsuarioFormateadoDyna" type="text" style="display: none;"
	value="0-0"></input>
<input id="usernameDyna" type="text" style="display: none;"
	value="0"></input>
<input id="segmentoEmpresa" type="text" style="display: none;"
	value="0"></input>
<input id="tipoUsuarioDyna" type="text" style="display: none;"
	value="0"></input>
<input id="razonSocialDyna" type="text" style="display: none;"
	value="-"></input>
<input id="razonSocialTrabDyna" type="text" style="display: none;"
	value="0"></input>
<input id="tipoAdministradorDyna" type="text" style="display: none;"
	value="0"></input>

<script type="text/javascript">

	var date = new Date();
    date.setTime(date.getTime()+(10*24*60*60*1000));
    var expires = "expires="+date.toGMTString();
	document.cookie = 'upv=/Search/Search Center/; '+expires+'; path=/';
		
	var rut_usuario = '0';
    var rut_empresa = '-';
    var num_contrato = '-';
    var username = '0';
    var jsession = 'BIDO_rob1NlX9vWuygTNKvE';

	function agregarEstadistica(urlFinal) {

		var data = new Object();
		data.rutUsuario = rut_usuario;
		data.rutEmpresa = rut_empresa;
		data.numContrato = num_contrato;
		data.jsession = jsession;
		data.username = username;
		data.urlFinal = urlFinal;
		var dataJson = JSON.stringify(data);

		jQuery.ajax({
			url : '/MutualThemeDynamic/estadisticas',
			cache : false,
			contentType : "application/json",
			dataType : "json",
			data : dataJson,
			method : 'POST',
			type : 'POST',
			success : function(data) {
				console.log("Estadisticas agregadas correctamente");
			}, error : function(data) {
				console.log("Error al agregar estadisticas");
			}
		});
	}
	
	
