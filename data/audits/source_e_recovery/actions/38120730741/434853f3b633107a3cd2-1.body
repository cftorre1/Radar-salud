<script src="/MutualThemeStatic/themes/MutualTheme/js/getBrowser.js"></script>
<script type="text/javascript">
	jquerync( document ).ready(function() {
	
	if (jquerync.browser.msie){
	
	
	
		var varIdSesion = 'BIDO_rob1NlX9vWuygTNKvE';
		    
		var sesionCookie= jquerync.cookie(varIdSesion);
		if(sesionCookie == '1'){ //si existe por defecto
		  	console.log(sesionCookie);
			jquerync( ".compatibilidadMutual" ).show();
		} else if(sesionCookie == '2'){//si existe pero se cerró
			console.log(sesionCookie);
			jquerync( ".compatibilidadMutual" ).hide();
		} else { //si no existe o tiene otro valor
		  jquerync.cookie(varIdSesion, '1', { expires : 7 });
		  jquerync( ".compatibilidadMutual" ).show();
