		margin-right: 0;
  }
	.footer-banner-box p.content-margin {
    margin-left: 60px;
}

  .header-top-right-sidebar > li.footer-banner-box.features-people {
    width: 40%  !important;
  }
}

.header-top-right-sidebar 
> li.footer-banner-box.features-laptop 
a {
  font-size: 20px;
}

/* POPUP FARMACIA VENTA PÚBLICO */

.popup-global {
  position: fixed;
  inset: 0;
  z-index: 99999;
}

.popup-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,.6);
}

.popup-contenido {
  position: relative;
  z-index: 2;
  max-width: 900px;
  margin: 5vh auto;
  padding: 0 20px;
}

.popup-contenido img {
  display: block;
  width: 100%;
  height: auto;
}

.popup-cerrar {
  position: absolute;
  top: 20px;
  right: 40px;
  z-index: 3;
	font-size: 30px;
  background: #fff;
  border: 0;
  width: 36px;
  height: 36px;
  cursor: pointer;
}

.popup-mobile {
  display: none;
}

@media (max-width: 767px) {
  .popup-desktop {
    display: none;
  }

  .popup-mobile {
    display: block;
  }
	
	.popup-contenido {
  max-width: 750px;
  margin: 15vh auto;
}
	
 .popup-cerrar {
  top: 10px;
  right: 30px;
	font-size: 20px;
  width: 26px;
  height: 26px;
}
}

.popup-wsp {
  font-family: 'Source Sans Pro', 'Arial', sans-serif !important;
}


.vc_btn3.vc_btn3-size-md {
    background-color: #348fff !important;
}

.vc_btn3.vc_btn3-size-md:hover {
    background-color: #002a6c !important;
}


