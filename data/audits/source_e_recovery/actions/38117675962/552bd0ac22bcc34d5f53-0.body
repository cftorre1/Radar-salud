<div id="popup-reserva-overlay"></div>

<div id="popup-reserva-modal">
  <button id="popup-reserva-cerrar">×</button>
  <h3>Selecciona tu sucursal:</h3>

  <div class="popup-opciones">
    <a href="https://patientportal.prod.regionales.procloudhub.com/#/patientPortal/redirect?centerId=6" target="_blank">Clínica Puerto Montt</a>
