  </div>
</div>

<script type="text/rocketlazyloadscript">
document.addEventListener('click', function(e) {
  const triggerClase = e.target.closest('.js-reservar-hora');
  const triggerHash = e.target.closest('a[href="#reservar-hora"]');

  if (triggerClase || triggerHash) {
    e.preventDefault();
    document.getElementById('popup-reserva-overlay').classList.add('activo');
    document.getElementById('popup-reserva-modal').classList.add('activo');
    return;
  }

  if (e.target.id === 'popup-reserva-overlay' || e.target.id === 'popup-reserva-cerrar') {
    document.getElementById('popup-reserva-overlay').classList.remove('activo');
    document.getElementById('popup-reserva-modal').classList.remove('activo');
  }
});
</script>					</div>
