<script data-type="vc_custom-js-footer">const track = document.getElementById('carouselTrack');
  const slides = document.querySelectorAll('.carousel-slide');
  const pagination = document.getElementById('carouselPagination');
  let currentIndex = 0;
  let interval;

  // Crear números de paginación
  slides.forEach((_, index) => {
    const pageNumber = document.createElement('div');
    pageNumber.classList.add('carousel-page');
    pageNumber.textContent = index + 1;
    if (index === 0) pageNumber.classList.add('active');
    pageNumber.addEventListener('click', () => moveToSlide(index));
    pagination.appendChild(pageNumber);
  });

  const pages = document.querySelectorAll('.carousel-page');

  // Función para mover el carrusel a un slide específico
  function moveToSlide(index) {
    currentIndex = index;
    updateCarousel();
  }

  // Actualizar el carrusel
  function updateCarousel() {
    track.style.transform = `translateX(-${currentIndex * 100}%)`;
    pages.forEach(page => page.classList.remove('active'));
    pages[currentIndex].classList.add('active');
  }

  // Función para mover al siguiente slide
  function moveToNextSlide() {
    currentIndex = (currentIndex + 1) % slides.length;
    updateCarousel();
  }

  // Iniciar carrusel automático
  function startCarousel() {
    interval = setInterval(moveToNextSlide, 5000); // Cambia cada 3 segundos
  }

  // Detener el carrusel
  function stopCarousel() {
    clearInterval(interval);
  }

  // Iniciar el carrusel al cargar la página
  startCarousel();

  // Detener el carrusel al pasar el mouse sobre el track y reanudar al quitar el mouse
  track.addEventListener('mouseenter', stopCarousel);
  track.addEventListener('mouseleave', startCarousel);</script><script type="text/rocketlazyloadscript"></script><script>window.lazyLoadOptions=[{elements_selector:"img[data-lazy-src],.rocket-lazyload,iframe[data-lazy-src]",data_src:"lazy-src",data_srcset:"lazy-srcset",data_sizes:"lazy-sizes",class_loading:"lazyloading",class_loaded:"lazyloaded",threshold:300,callback_loaded:function(element){if(element.tagName==="IFRAME"&&element.dataset.rocketLazyload=="fitvidscompatible"){if(element.classList.contains("lazyloaded")){if(typeof window.jQuery!="undefined"){if(jQuery.fn.fitVids){jQuery(element).parent().fitVids()}}}}}},{elements_selector:".rocket-lazyload",data_src:"lazy-src",data_srcset:"lazy-srcset",data_sizes:"lazy-sizes",class_loading:"lazyloading",class_loaded:"lazyloaded",threshold:300,}];window.addEventListener('LazyLoad::Initialized',function(e){var lazyLoadInstance=e.detail.instance;if(window.MutationObserver){var observer=new MutationObserver(function(mutations){var image_count=0;var iframe_count=0;var rocketlazy_count=0;mutations.forEach(function(mutation){for(var i=0;i<mutation.addedNodes.length;i++){if(typeof mutation.addedNodes[i].getElementsByTagName!=='function'){continue}
