         display: flex;
    }
      .header-top-right-sidebar .footer-banner-box {
          width: 50%;
     }
}

@media (min-width: 1200px) {
    .home-box, .home-box-container-list.for-home-slider .home-box, .home-box-container-list.float .home-box {
        width: 555px;
    }
