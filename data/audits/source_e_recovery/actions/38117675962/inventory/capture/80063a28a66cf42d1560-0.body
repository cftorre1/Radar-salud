	<div  class="wpb_single_image wpb_content_element vc_align_center wpb_content_element">
		
		<figure class="wpb_wrapper vc_figure">
			<div class="vc_single_image-wrapper  "><img decoding="async" width="1230" height="418" src="https://clinicamaitenes.cl/wp-content/uploads/slider2/Banner-campana-12-cuotas.png" class="vc_single_image-img attachment-full" alt="" title="Banner-campana-12-cuotas" srcset="https://clinicamaitenes.cl/wp-content/uploads/slider2/Banner-campana-12-cuotas.png 1230w, https://clinicamaitenes.cl/wp-content/uploads/slider2/Banner-campana-12-cuotas-300x102.png 300w, https://clinicamaitenes.cl/wp-content/uploads/slider2/Banner-campana-12-cuotas-1024x348.png 1024w, https://clinicamaitenes.cl/wp-content/uploads/slider2/Banner-campana-12-cuotas-768x261.png 768w" sizes="(max-width: 1230px) 100vw, 1230px" /></div>
		</figure>
	</div>

