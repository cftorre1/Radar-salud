<script type="text/rocketlazyloadscript">
document.addEventListener('DOMContentLoaded', function () {
  var modal = document.getElementById('myModal');
  if (!modal) return;

  var abrir  = function () { modal.style.display = 'block'; };
  var cerrar = function () { modal.style.display = 'none'; };

  // Un solo listener para todo el documento (delegaci��n)
  document.addEventListener('click', function (e) {
    // Abrir: cualquier elemento con la clase .abre-reserva (o algo dentro de ��l)
    if (e.target.closest('.abre-reserva')) {
      e.preventDefault();
      abrir();
      return;
    }
    // Cerrar: clic en la X o en el fondo oscuro
    if (e.target.closest('#close-modal-a') || e.target === modal) {
      cerrar();
    }
  });

  // Cerrar con Escape
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') cerrar();
  });
});
</script>

