{
 "schema_version": 1,
 "purpose": "WATCH: seguimiento determinista por entidad (Dirección 27-oct-2026). Etiqueta señales con entity_refs.",
 "matching": {
  "text_fields": [
   "title",
   "display_title",
   "what_happened",
   "card_what",
   "official_subject",
   "regulated_entity"
  ],
  "normalization": "NFKD sin tildes, espacios colapsados; se conserva mayúscula/minúscula. Los patrones se escriben sin tildes.",
  "pattern": "re: expresión regular; ci: ignora mayúsculas; context: otra expresión (ignora mayúsculas) que debe aparecer en el mismo texto.",
  "exclude": "Tramos que se borran antes de evaluar los patrones de esa entidad.",
  "source_names": "Nombre de fuente (canal propio de la entidad) que asigna la entidad a toda la pieza.",
  "urls": "Solo URLs ya presentes en datos del repositorio; null = por verificar. CMF solo desde data/entities/cmf_reporting_actors.json."
 },
 "kinds": [
  "prestador",
  "isapre",
  "asegurador_publico",
  "mutualidad",
  "regulador",
  "gremio",
  "farma"
 ],
