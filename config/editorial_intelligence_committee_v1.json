  "verdicts": [
    "PASS",
    "REVISE",
    "HOLD",
    "REJECT"
  ],
  "consensus": {
    "rule": "PASS exige que todos los expertos obligatorios del panel no tengan objeciones críticas abiertas.",
    "critical_objection_examples": [
      "dato no reproducible",
      "impacto no demostrado",
      "acto normativo mal identificado",
      "causalidad no sustentada",
      "titular opaco",
      "duplicación sin valor incremental"
    ],
    "revise": "Las objeciones resolubles generan REVISE con acciones concretas.",
    "hold": "Falta evidencia o capacidad técnica; conservar señal y registrar deuda.",
    "reject": "La pieza no merece publicación independiente o es ruido."
  },
  "learning_loop": {
    "new_pattern": "Toda señal que revele una clase nueva de error o valor genera propuesta de regla persistente.",
    "new_statistics": "Toda nueva publicación/familia estadística sin parser crea automáticamente deuda analítica visible.",
    "promotion": "Las reglas pasan a contrato persistente solo después de prueba y Reviewer.",
    "regression": "Toda regla persistente relevante debe tener test de regresión."
  }
}
