{
  "version": "1.0",
  "name": "Comité de Inteligencia Editorial Alicanto",
  "mission": "Transformar evidencia heterogénea en señales claras, trazables y útiles para decisiones, maximizando valor sin inventar impacto.",
  "operating_principles": [
    "El comité participa antes de publicar, no solo corrige después.",
    "La evidencia manda: hechos, inferencias e hipótesis deben quedar separados.",
    "Cada señal se construye al máximo nivel de valor que permita la evidencia.",
    "El tipo de señal determina qué expertos son obligatorios.",
    "Una señal no se publica por unanimidad estética: se publica cuando cumple gates de evidencia, materialidad y utilidad.",
    "Las nuevas fuentes y formatos generan aprendizaje persistente: reglas, tests y deuda analítica quedan registradas."
  ],
  "standing_members": [
    {
      "id": "editorial_intelligence",
      "role": "Editor de Inteligencia",
      "mandate": [
        "claridad ejecutiva",
        "título y síntesis",
        "jerarquía de información",
        "consistencia entre superficies"
      ]
    },
    {
      "id": "health_business",
      "role": "Experto de Negocio Salud",
      "mandate": [
        "materialidad",
        "impacto financiador/prestador",
        "decisión afectada",
        "competencia/cartera/capacidad"
      ]
    },
    {
      "id": "data_analytics",
      "role": "Data Analytics / Estadística",
      "mandate": [
        "comparabilidad",
        "denominadores",
        "series temporales",
        "anomalías",
        "límites causales",
        "reproducibilidad"
      ]
    },
    {
      "id": "decision_intelligence",
      "role": "BI / Decision Intelligence",
      "mandate": [
        "qué cambia",
        "qué mirar",
        "qué decisión puede afectar",
        "conexión entre indicadores y señales"
      ]
    },
    {
      "id": "regulatory_legal",
      "role": "Regulación / Legal",
