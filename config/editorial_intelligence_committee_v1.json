        "corroboración",
        "mapa de evidencia",
        "incertidumbres",
        "atribución"
      ]
    },
    {
      "id": "regulatory_business_editor",
      "role": "Regulatory Business Editor",
      "mandate": [
        "traducir efecto jurídico a lenguaje ejecutivo",
        "claridad de qué cambia y quién actúa",
        "test de comprensión en cinco segundos"
      ]
    }
  ],
  "conditional_members": [
    {
